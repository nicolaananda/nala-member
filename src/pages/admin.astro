---
import '../styles.css';
const api = import.meta.env.PUBLIC_API_URL || 'https://api.artstudionala.com';
---
<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Admin Member · Artstudio Nala</title><meta name="robots" content="noindex,nofollow"></head><body class="admin-shell" data-api={api}><header class="site-header"><div class="wrap header-inner"><a class="brand" href="/" aria-label="Beranda"><img src="/nala-logo.png" alt="Artstudio Nala"><span><strong>Studio Admin</strong><small>Kelola ruang belajar</small></span></a><nav class="nav" aria-label="Admin"><button data-view="plans"><span aria-hidden="true">◇</span> Produk</button><button data-view="courses"><span aria-hidden="true">▤</span> Kursus</button><button data-view="members"><span aria-hidden="true">◎</span> Member</button><button id="logout" class="hidden">Keluar</button></nav></div></header><main class="wrap member-layout"><p id="notice" class="message" role="status" aria-live="polite"></p><section id="login" class="auth-shell"><form id="login-form" class="card"><span class="eyebrow">Area terbatas</span><h1>Admin Member</h1><p class="muted">Masuk untuk mengelola produk, materi kelas, dan akses member.</p><label class="field">Email admin<input name="email" type="email" autocomplete="username" maxlength="254" required></label><label class="field">Password<input name="password" type="password" autocomplete="current-password" required></label><button class="primary">Masuk</button></form></section><section id="app" class="hidden"><section id="plans-view"><div class="section-head"><div><span class="eyebrow">Membership</span><h1>Produk member</h1><p class="muted">Harga di sini menjadi sumber resmi checkout. Checkout tetap mengikuti gate penyedia pembayaran.</p></div></div><form id="new-plan" class="card toolbar"><label class="field">Nama<input name="name" maxlength="100" minlength="2" required></label><label class="field">Harga Rupiah<input name="price" type="number" min="1" max="1000000000" step="1" required></label><label class="field">Durasi hari<input name="durationDays" type="number" min="1" max="730" step="1" required></label><button class="primary">Tambah produk</button></form><div id="plans" class="orders"></div></section><section id="courses-view" class="hidden"><div class="section-head"><div><span class="eyebrow">Materi</span><h1>Kursus, bab, video, worksheet</h1></div></div><form id="new-course" class="card toolbar"><label class="field">Judul<input name="title" maxlength="200" required></label><label class="field">Slug<input name="slug" pattern="[a-z0-9-]{2,100}" required></label><label class="field">Kategori<input name="category" maxlength="100"></label><label class="field">Urutan<input name="sortOrder" type="number" min="0" value="0" required></label><button class="primary">Tambah draft</button></form><div id="courses" class="orders"></div></section><section id="members-view" class="hidden"><div class="section-head"><div><span class="eyebrow">Operasional</span><h1>Member, transaksi, akses</h1></div></div><form id="member-search" class="toolbar"><label class="field">Cari nama atau email<input name="q" type="search" maxlength="200"></label><label class="field">Status<select name="status"><option value="all">Semua</option><option value="active">Aktif</option><option value="expiring">Segera berakhir</option><option value="expired">Berakhir</option><option value="suspended">Disuspensi</option></select></label><button class="secondary">Cari</button></form><div id="members" class="orders"></div><article id="member-detail" class="card hidden"></article></section></section></main><script>
const API=document.body.dataset.api,$=s=>document.querySelector(s),notice=$('#notice');let courses=[];const say=(t,e=false)=>{notice.textContent=t||'';notice.className=`message ${e?'error':'success'}`};const call=async(path,init={})=>{const r=await fetch(API+path,{credentials:'include',headers:{'Content-Type':'application/json'},...init}),x=await r.json().catch(()=>({message:'Respons server tidak valid'}));if(!r.ok)throw Object.assign(Error(x.message||'Permintaan gagal'),{status:r.status});return x};const data=f=>Object.fromEntries(new FormData(f)),control=(f,name)=>f.elements.namedItem(name);const node=(tag,text='',cls='')=>{const n=document.createElement(tag);n.textContent=text;n.className=cls;return n};
async function run(fn){try{say('');await fn()}catch(e){say(e.message,true);if(e.status===401)loggedOut()}}function loggedOut(){$('#login').classList.remove('hidden');$('#app').classList.add('hidden');$('#logout').classList.add('hidden')}
async function boot(){try{await call('/api/admin/me');$('#login').classList.add('hidden');$('#app').classList.remove('hidden');$('#logout').classList.remove('hidden');await loadPlans()}catch{loggedOut()}}
async function show(view){['plans','courses','members'].forEach(x=>$(`#${x}-view`).classList.toggle('hidden',x!==view));document.querySelectorAll('[data-view]').forEach(b=>b.setAttribute('aria-current',b.dataset.view===view?'page':'false'));if(view==='plans')return loadPlans();if(view==='courses')return loadCourses();if(view==='members')return loadMembers()}
async function loadPlans(){const x=await call('/api/admin/member-program/config'),root=$('#plans');root.replaceChildren();x.plans.forEach(p=>{const f=node('form','', 'card toolbar');f.innerHTML=`<label class="field">Nama<input name="name" maxlength="100" minlength="2" required></label><label class="field">Harga Rupiah<input name="price" type="number" min="1" max="1000000000" step="1" required></label><label class="field">Durasi hari<input name="durationDays" type="number" min="1" max="730" required></label><label class="field">Status<select name="status"><option value="active">Aktif</option><option value="archived">Arsip</option></select></label><button class="primary">Simpan</button><button type="button" class="danger">Arsipkan</button>`;control(f,'name').value=p.name;control(f,'price').value=p.price;control(f,'durationDays').value=p.duration_days;control(f,'status').value=p.status;f.onsubmit=e=>{e.preventDefault();const d=data(f);run(async()=>{await call(`/api/admin/member-program/plans/${p.id}`,{method:'PUT',body:JSON.stringify({...d,price:Number(d.price),durationDays:Number(d.durationDays)})});say('Produk disimpan.');await loadPlans()})};f.querySelector('.danger').onclick=()=>{if(confirm(`Arsipkan produk ${p.name}? Produk tidak akan tersedia untuk checkout baru.`))run(async()=>{await call(`/api/admin/member-program/plans/${p.id}`,{method:'DELETE',body:'{}'});await loadPlans()})};root.append(f)})}
$('#new-plan').onsubmit=e=>{e.preventDefault();const f=e.currentTarget,d=data(f);run(async()=>{await call('/api/admin/member-program/plans',{method:'POST',body:JSON.stringify({...d,price:Number(d.price),durationDays:Number(d.durationDays)})});f.reset();await loadPlans()})};
async function loadCourses(){const x=await call('/api/admin/member/courses'),root=$('#courses');courses=x.courses;root.replaceChildren();courses.forEach(c=>{const card=node('article','', 'card'),head=node('div','', 'order-head'),title=node('strong',c.title),toggle=node('button','Kelola','secondary'),body=node('div','', 'hidden');head.append(title,node('span',c.status,'pill'),toggle);toggle.onclick=()=>body.classList.toggle('hidden');const f=node('form','', 'toolbar');f.innerHTML=`<label class="field">Judul<input name="title" required maxlength="200"></label><label class="field">Slug<input name="slug" required pattern="[a-z0-9-]{2,100}"></label><label class="field">Kategori<input name="category" maxlength="100"></label><label class="field">Thumbnail HTTPS<input name="imageUrl" type="url"></label><label class="field">Urutan<input name="sortOrder" type="number" min="0" required></label><label class="field">Status<select name="status"><option value="draft">Draft</option><option value="published">Terbit</option><option value="archived">Arsip</option></select></label><label class="field">Deskripsi<textarea name="description" maxlength="5000"></textarea></label><button class="primary">Simpan kursus</button><button type="button" class="danger">Arsipkan</button>`;for(const k of ['title','slug','category'])control(f,k).value=c[k]||'';control(f,'imageUrl').value=c.image_url||'';control(f,'sortOrder').value=c.sort_order;control(f,'status').value=c.status;control(f,'description').value=c.description||'';f.onsubmit=e=>{e.preventDefault();const d=data(f);run(async()=>{await call(`/api/admin/member/courses/${c.id}`,{method:'PUT',body:JSON.stringify({...d,sortOrder:Number(d.sortOrder)})});await loadCourses()})};f.querySelector('.danger').onclick=()=>{if(confirm(`Arsipkan kursus ${c.title}?`))run(async()=>{await call(`/api/admin/member/courses/${c.id}`,{method:'DELETE',body:'{}'});await loadCourses()})};body.append(f);(c.chapters||[]).forEach(ch=>body.append(chapter(c,ch)));const add=node('form','', 'toolbar');add.innerHTML='<label class="field">Bab baru<input name="title" maxlength="200" required></label><label class="field">Urutan<input name="sortOrder" type="number" min="0" value="0" required></label><button class="secondary">Tambah bab</button>';add.onsubmit=e=>{e.preventDefault();const d=data(add);run(async()=>{await call('/api/admin/member/chapters',{method:'POST',body:JSON.stringify({courseId:c.id,title:d.title,sortOrder:Number(d.sortOrder)})});await loadCourses()})};body.append(add);card.append(head,body);root.append(card)})}
function chapter(c,ch){const box=node('section','', 'card'),h=node('h3',ch.title);box.append(h);(ch.lessons||[]).forEach(l=>{const f=node('form','', 'toolbar');f.innerHTML='<label class="field">Video/materi<input name="title" required maxlength="200"></label><label class="field">YouTube ID<input name="youtubeVideoId" pattern="[A-Za-z0-9_-]{11}"></label><label class="field">Urutan<input name="sortOrder" type="number" min="0" required></label><label><input name="isPreview" type="checkbox"> Pratinjau</label><label class="field">Deskripsi<textarea name="description" maxlength="5000"></textarea></label><button class="primary">Simpan</button><button type="button" class="danger">Hapus</button><label class="field">Tambah worksheet PDF<input class="pdf" type="file" accept="application/pdf,.pdf"></label>';control(f,'title').value=l.title;control(f,'youtubeVideoId').value=l.youtubeVideoId||'';control(f,'sortOrder').value=l.sortOrder;control(f,'isPreview').checked=l.isPreview;control(f,'description').value=l.description||'';f.onsubmit=e=>{e.preventDefault();const d=data(f);run(async()=>{await call(`/api/admin/member/lessons/${l.id}`,{method:'PUT',body:JSON.stringify({...d,sortOrder:Number(d.sortOrder),isPreview:control(f,'isPreview').checked})});say('Materi disimpan.')})};f.querySelector('.danger').onclick=()=>{if(confirm(`Hapus materi ${l.title} beserta worksheet? Tindakan ini tidak dapat dibatalkan.`))run(async()=>{await call(`/api/admin/member/lessons/${l.id}`,{method:'DELETE',body:'{}'});await loadCourses()})};f.querySelector('.pdf').onchange=e=>uploadWorksheet(l.id,e.target.files[0]);box.append(f)});const add=node('form','', 'toolbar');add.innerHTML='<label class="field">Materi baru<input name="title" required maxlength="200"></label><label class="field">YouTube ID<input name="youtubeVideoId" pattern="[A-Za-z0-9_-]{11}"></label><label class="field">Urutan<input name="sortOrder" type="number" min="0" value="0" required></label><button class="secondary">Tambah materi</button>';add.onsubmit=e=>{e.preventDefault();const d=data(add);run(async()=>{await call('/api/admin/member/lessons',{method:'POST',body:JSON.stringify({chapterId:ch.id,...d,sortOrder:Number(d.sortOrder),isPreview:false})});await loadCourses()})};box.append(add);return box}
function uploadWorksheet(lessonId,file){return run(async()=>{if(!file||file.type!=='application/pdf'||file.size>10*1024*1024)throw Error('Pilih PDF maksimal 10 MB.');const base64=await new Promise((ok,no)=>{const r=new FileReader();r.onload=()=>ok(String(r.result).split(',')[1]);r.onerror=()=>no(Error('PDF gagal dibaca.'));r.readAsDataURL(file)});await call('/api/admin/member/worksheets',{method:'POST',body:JSON.stringify({lessonId,title:file.name.replace(/\.pdf$/i,''),fileName:file.name,base64})});say('Worksheet diunggah.');await loadCourses()})}
$('#new-course').onsubmit=e=>{e.preventDefault();const f=e.currentTarget,d=data(f);run(async()=>{await call('/api/admin/member/courses',{method:'POST',body:JSON.stringify({...d,description:'',imageUrl:'',status:'draft',sortOrder:Number(d.sortOrder)})});f.reset();await loadCourses()})};
async function loadMembers(){const f=$('#member-search'),d=data(f),x=await call(`/api/admin/member/members?status=${d.status}&q=${encodeURIComponent(d.q)}&page=1`),root=$('#members');root.replaceChildren();x.members.forEach(m=>{const row=node('article','', 'card order-head'),label=node('span',`${m.name} · ${m.email}`),b=node('button','Detail','secondary');b.onclick=()=>run(()=>memberDetail(m.id));row.append(label,b);root.append(row)})}$('#member-search').onsubmit=e=>{e.preventDefault();run(loadMembers)};
async function memberDetail(id,orders='active'){const x=await call(`/api/admin/member/members/${id}?orders=${orders}`),root=$('#member-detail');root.classList.remove('hidden');root.replaceChildren(node('h2',x.account.email),node('p',`Akses: ${x.account.membership_expires_at||'belum aktif'}`),node('p',`${x.orders.length} pesanan · ${x.accessHistory.length} perubahan akses`));const filters=node('div','','order-filters'),active=node('button','Aktif','secondary'),archived=node('button','Arsip','secondary');active.type=archived.type='button';active.disabled=orders==='active';archived.disabled=orders==='archived';active.onclick=()=>run(()=>memberDetail(id,'active'));archived.onclick=()=>run(()=>memberDetail(id,'archived'));filters.append(active,archived);root.append(filters);const list=node('div','','order-list');x.orders.forEach(o=>{const row=node('article','','order-row'),info=node('div');info.append(node('strong',o.order_id),node('span',`${new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0}).format(o.amount)} · ${o.duration_days} hari`),node('span',new Date(o.created_at).toLocaleString('id-ID')),node('span',o.status,'pill'));const action=node('button',orders==='archived'?'Pulihkan':'Batalkan & arsipkan',orders==='archived'?'secondary':'danger');action.type='button';if(!o.archived_at&&['paid'].includes(o.status))action.disabled=true;action.onclick=()=>run(async()=>{const reason=prompt(orders==='archived'?'Alasan pemulihan:':'Alasan pembatalan dan arsip:');if(!reason?.trim())return;if(!confirm(`${orders==='archived'?'Pulihkan':'Batalkan dan arsipkan'} ${o.order_id}?`))return;action.disabled=true;try{await call(`/api/admin/member/orders/${o.order_id}/${orders==='archived'?'restore':'archive'}`,{method:'POST',body:JSON.stringify({confirm:true,reason:reason.trim()})});say(orders==='archived'?'Pesanan dipulihkan.':'Pesanan dibatalkan dan diarsipkan.');await memberDetail(id,orders)}finally{action.disabled=false}});row.append(info,action);list.append(row)});if(!x.orders.length)list.append(node('p',orders==='archived'?'Belum ada pesanan arsip.':'Belum ada pesanan aktif.','muted'));root.append(list);const f=node('form','', 'toolbar');f.innerHTML='<label class="field">Operasi<select name="operation"><option value="grant">Tambah</option><option value="revoke">Kurangi</option></select></label><label class="field">Hari<input name="days" type="number" min="1" max="365" required></label><label class="field">Alasan<input name="reason" minlength="1" maxlength="200" required></label><button class="danger">Ubah akses</button>';f.onsubmit=e=>{e.preventDefault();const d=data(f);if(!confirm(`${d.operation==='grant'?'Tambah':'Kurangi'} akses ${d.days} hari untuk ${x.account.email}?`))return;run(async()=>{await call(`/api/admin/member/members/${id}/access`,{method:'POST',body:JSON.stringify({...d,days:Number(d.days),confirm:true})});say('Akses diperbarui.');await memberDetail(id,orders)})};root.append(f)}
$('#login-form').onsubmit=e=>{e.preventDefault();const f=e.currentTarget;run(async()=>{await call('/api/admin/login',{method:'POST',body:JSON.stringify(data(f))});f.reset();await boot()})};$('#logout').onclick=()=>run(async()=>{await call('/api/admin/logout',{method:'POST',body:'{}'});loggedOut()});document.querySelectorAll('[data-view]').forEach(b=>b.onclick=()=>run(()=>show(b.dataset.view)));boot();
</script></body></html>
