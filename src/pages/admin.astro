---
import '../styles.css';
const api = import.meta.env.PUBLIC_API_URL || 'https://api.artstudionala.com';
---
<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Operasional Member · Artstudio Nala</title><meta name="robots" content="noindex,nofollow"></head><body class="admin-shell" data-api={api}>
<header class="site-header"><div class="wrap header-inner"><a class="brand" href="/" aria-label="Beranda"><img src="/nala-logo.png" alt="Artstudio Nala"><span><strong>Operasional</strong><small>Member Nala</small></span></a><nav class="nav" aria-label="Admin"><button data-view="plans">Produk</button><button data-view="courses">Kursus</button><button data-view="orders">Pesanan</button><button data-view="members">Member</button><button data-view="evaluations">Evaluasi</button><button id="logout" class="hidden">Keluar</button></nav></div></header>
<main class="wrap member-layout"><p id="notice" class="message" role="status" aria-live="polite"></p>
<section id="login" class="auth-shell"><form id="login-form" class="card narrow"><span class="eyebrow">Area terbatas</span><h1>Admin member</h1><p class="muted">Masuk untuk mengelola katalog dan akses member.</p><label class="field">Email<input name="email" type="email" autocomplete="username" required></label><label class="field">Password<input name="password" type="password" autocomplete="current-password" required></label><button class="primary">Masuk</button></form></section>
<section id="app" class="hidden">
<section id="plans-view"><div class="section-head"><div><span class="eyebrow">Produk</span><h1>Paket membership</h1><p class="muted">Paket baru berisi kursus terpilih. Paket legacy tetap mencakup seluruh katalog.</p></div><a class="button" href="/admin/produk/edit/?id=new">+ Tambah produk</a></div><div class="filters"><label class="sr-only" for="plan-q">Cari produk</label><input id="plan-q" type="search" placeholder="Cari produk"><label class="sr-only" for="plan-status">Status produk</label><select id="plan-status"><option value="all">Semua status</option><option value="active">Aktif</option><option value="archived">Arsip</option></select></div><div id="plans" class="ops-list"></div></section>
<section id="courses-view" class="hidden"><div class="section-head"><div><span class="eyebrow">Kursus & materi</span><h1>Katalog pembelajaran</h1></div><a class="button" href="/admin/kursus/edit/?id=new">+ Tambah kursus</a></div><div class="filters"><label class="sr-only" for="course-q">Cari kursus</label><input id="course-q" type="search" placeholder="Cari judul atau kategori"><label class="sr-only" for="course-status">Status kursus</label><select id="course-status"><option value="all">Semua status</option><option value="draft">Draft</option><option value="published">Terbit</option><option value="archived">Arsip</option></select></div><div id="courses" class="ops-list"></div><section id="course-detail" class="hidden"></section></section>
<section id="orders-view" class="hidden"><div class="section-head"><div><span class="eyebrow">Pesanan</span><h1>Semua transaksi</h1><p class="muted">Batalkan & arsipkan akan membatalkan pembayaran pending di penyedia. Pesanan dibayar dilindungi.</p></div></div><form id="order-filter" class="filters"><label class="sr-only">Cari pesanan<input name="q" type="search" placeholder="Cari ID, nama, atau email"></label><label class="sr-only">Status pesanan<select name="status"><option value="all">Semua status</option><option value="pending">Pending</option><option value="paid">Dibayar</option><option value="expired">Kedaluwarsa</option><option value="cancelled">Dibatalkan</option><option value="denied">Ditolak</option></select></label><label class="sr-only">Status arsip<select name="archived"><option value="active">Aktif</option><option value="archived">Arsip</option><option value="all">Semua arsip</option></select></label><button class="secondary">Terapkan</button></form><div id="orders" class="ops-list"></div><div id="order-pages" class="pager"></div></section>
<section id="members-view" class="hidden"><div class="section-head"><div><span class="eyebrow">Member</span><h1>Akun & akses</h1></div></div><form id="member-search" class="filters"><label class="sr-only">Cari member<input name="q" type="search" placeholder="Cari nama atau email"></label><label class="sr-only">Status member<select name="status"><option value="all">Semua status</option><option value="active">Aktif</option><option value="expiring">Segera berakhir</option><option value="expired">Berakhir</option><option value="suspended">Ditangguhkan</option></select></label><button class="secondary">Cari</button></form><div id="members" class="ops-list"></div><section id="member-detail" class="card hidden"></section></section>
<section id="evaluations-view" class="hidden"><div class="section-head"><div><span class="eyebrow">Evaluasi</span><h1>Karya murid</h1><p class="muted">Lihat karya lalu kirim masukan yang ramah dan jelas.</p></div><button id="refresh-evaluations" class="secondary">Perbarui</button></div><div id="evaluations" class="evaluation-grid" aria-live="polite"></div></section>
</section></main>
<dialog id="plan-dialog"><form id="plan-form" class="dialog-card"><header><div><span class="eyebrow">Produk</span><h2 id="plan-title">Tambah produk</h2></div><button type="button" class="icon close" aria-label="Tutup">×</button></header><input name="id" type="hidden"><label class="field">Nama<input name="name" maxlength="100" minlength="2" required></label><div class="form-grid"><label class="field">Harga (IDR)<input name="price" type="number" min="1" max="1000000000" required></label><label class="field">Durasi hari<input name="durationDays" type="number" min="1" max="730" required></label></div><p id="plan-active-note" class="muted">Produk baru langsung aktif setelah disimpan.</p><label id="plan-status-field" class="field">Status<select name="status"><option value="active">Aktif</option><option value="archived">Arsip</option></select></label><aside class="buyer-preview"><small>PRATINJAU LOKAL · BELUM DISIMPAN</small><strong id="preview-name">Nama paket</strong><b id="preview-price">Rp0</b><span id="preview-duration">0 hari akses seluruh katalog terbit</span></aside><footer><button type="button" class="secondary close">Batal</button><button class="primary">Simpan</button></footer></form></dialog>
<dialog id="course-dialog"><form id="course-form" class="dialog-card"><header><div><span class="eyebrow">Kursus</span><h2 id="course-title">Tambah kursus</h2></div><button type="button" class="icon close" aria-label="Tutup">×</button></header><input name="id" type="hidden"><label class="field">Judul<input name="title" maxlength="200" required></label><div class="form-grid"><label class="field">Slug<input name="slug" pattern="[a-z0-9-]{2,100}" required></label><label class="field">Kategori<input name="category" maxlength="100"></label></div><label class="field">Thumbnail HTTPS<input name="imageUrl" type="url"></label><label class="field">Deskripsi<textarea name="description" maxlength="5000"></textarea></label><div class="form-grid"><label class="field">Urutan<input name="sortOrder" type="number" min="0" required></label><label class="field">Status<select name="status"><option value="draft">Draft</option><option value="published">Terbit</option><option value="archived">Arsip</option></select></label></div><footer><button type="button" class="secondary close">Batal</button><button class="primary">Simpan</button></footer></form></dialog>
<dialog id="order-dialog"><div class="dialog-card"><header><div><span class="eyebrow">Detail pesanan</span><h2 id="order-title"></h2></div><button class="icon close" aria-label="Tutup">×</button></header><div id="order-detail"></div></div></dialog>
<script>
import {parseYouTube} from '../lib/youtube.js';
const API=document.body.dataset.api,$=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)],money=n=>new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0}).format(n||0),wib=x=>x?new Intl.DateTimeFormat('id-ID',{dateStyle:'medium',timeStyle:'short',timeZone:'Asia/Jakarta',hour12:false}).format(new Date(x))+' WIB':'—';
let epoch=0,courses=[],plans=[],orderPage=1,orderRequest=0,memberRequest=0;const notice=$('#notice'),node=(tag,text='',cls='')=>Object.assign(document.createElement(tag),{textContent:text,className:cls}),data=f=>Object.fromEntries(new FormData(f)),ctl=(f,n)=>f.elements.namedItem(n);
function say(text,error=false){notice.textContent=text;notice.className=`message ${error?'error':'success'}`}
function busy(form,on){[...form.querySelectorAll('button')].forEach(b=>b.disabled=on);form.setAttribute('aria-busy',String(on))}
async function call(path,init={}){const token=epoch,r=await fetch(API+path,{credentials:'include',headers:{'Content-Type':'application/json'},...init});if(token!==epoch)throw Object.assign(Error('Permintaan usang'),{stale:true});const x=await r.json().catch(()=>({message:'Respons server tidak valid'}));if(token!==epoch)throw Object.assign(Error('Permintaan usang'),{stale:true});if(!r.ok)throw Object.assign(Error(x.message||'Permintaan gagal'),{status:r.status});return x}
async function run(fn,form){try{say('');if(form)busy(form,true);await fn()}catch(e){if(!e.stale)say(e.message,true);if(e.status===401)loggedOut()}finally{if(form)busy(form,false)}}
function loggedOut(){epoch++;orderRequest++;memberRequest++;courses=[];plans=[];orderPage=1;['plans','courses','orders','members','course-detail','member-detail','order-pages','order-detail'].forEach(id=>{const el=$('#'+id);if(el)el.replaceChildren()});$$('form').forEach(f=>{f.reset();f.removeAttribute('aria-busy')});['plan-q','course-q'].forEach(id=>$('#'+id).value='');['plan-status','course-status'].forEach(id=>$('#'+id).value='all');$('#order-title').textContent='';$('#preview-name').textContent='Nama paket';$('#preview-price').textContent='Rp0';$('#preview-duration').textContent='0 hari akses seluruh katalog terbit';$$('dialog[open]').forEach(d=>d.close());$$('button').forEach(b=>b.disabled=false);$('#login').classList.remove('hidden');$('#app').classList.add('hidden');$('#logout').classList.add('hidden');say('')}
async function boot(){try{await call('/api/admin/me');$('#login').classList.add('hidden');$('#app').classList.remove('hidden');$('#logout').classList.remove('hidden');const wanted=new URLSearchParams(location.search).get('view');await show(['plans','courses','orders','members','evaluations'].includes(wanted)?wanted:'plans')}catch{loggedOut()}}
async function show(view){['plans','courses','orders','members','evaluations'].forEach(x=>$(`#${x}-view`).classList.toggle('hidden',x!==view));$$('[data-view]').forEach(b=>b.setAttribute('aria-current',b.dataset.view===view?'page':'false'));if(view==='plans')await loadPlans();if(view==='courses')await loadCourses();if(view==='orders')await loadOrders();if(view==='members')await loadMembers();if(view==='evaluations')await loadEvaluations()}
function empty(root,text){root.replaceChildren(node('p',text,'card empty'))}
async function loadPlans(){const root=$('#plans');root.innerHTML='<p class="card empty">Memuat produk…</p>';try{plans=(await call('/api/admin/member-program/config')).plans;renderPlans()}catch(e){if(!e.stale)empty(root,'Produk gagal dimuat.');throw e}}
function renderPlans(){const q=$('#plan-q').value.toLowerCase(),status=$('#plan-status').value,rows=plans.filter(p=>(status==='all'||p.status===status)&&p.name.toLowerCase().includes(q)),root=$('#plans');root.replaceChildren();if(!rows.length)return empty(root,'Produk tidak ditemukan.');rows.forEach(p=>{const r=node('article','','ops-row');r.innerHTML=`<div><strong></strong><span class="pill"></span><p></p></div><button class="secondary">Detail & edit</button>`;r.querySelector('strong').textContent=p.name;r.querySelector('.pill').textContent=p.status;const names=(p.courses||[]).map(c=>c.title),mode=p.access_mode==='selected'?`Kursus terpilih (${names.length}): ${names.join(', ')||'belum ada'}`:'Legacy · seluruh katalog';r.querySelector('p').textContent=`${money(p.price)} · ${p.duration_days} hari · ${mode}`;const a=node('a','Detail & edit','button');a.href=`/admin/produk/edit/?id=${p.id}`;r.querySelector('button').replaceWith(a);root.append(r)})}
function openPlan(p){const f=$('#plan-form');f.reset();$('#plan-title').textContent=p?'Edit produk':'Tambah produk';$('#plan-status-field').classList.toggle('hidden',!p);$('#plan-active-note').classList.toggle('hidden',Boolean(p));for(const [k,v] of Object.entries(p?{id:p.id,name:p.name,price:p.price,durationDays:p.duration_days,status:p.status}:{id:'',status:'active'}))ctl(f,k).value=v;previewPlan();$('#plan-dialog').showModal()}
function previewPlan(){const f=$('#plan-form');$('#preview-name').textContent=ctl(f,'name').value||'Nama paket';$('#preview-price').textContent=money(ctl(f,'price').value);$('#preview-duration').textContent=`${ctl(f,'durationDays').value||0} hari akses seluruh katalog terbit`}
$('#plan-form').oninput=previewPlan;$('#plan-form').onsubmit=e=>{e.preventDefault();const f=e.currentTarget,d=data(f),id=d.id;if(id&&d.status==='archived'&&!confirm(`Arsipkan produk ${d.name}? Produk tidak tersedia untuk checkout baru.`))return;run(async()=>{await call(id?`/api/admin/member-program/plans/${id}`:'/api/admin/member-program/plans',{method:id?'PUT':'POST',body:JSON.stringify({name:d.name,price:Number(d.price),durationDays:Number(d.durationDays),...(id?{status:d.status}:{})})});f.closest('dialog').close();say('Produk disimpan.');await loadPlans()},f)};
async function loadCourses(){const root=$('#courses');root.innerHTML='<p class="card empty">Memuat kursus…</p>';try{courses=(await call('/api/admin/member/courses')).courses;renderCourses()}catch(e){if(!e.stale)empty(root,'Kursus gagal dimuat.');throw e}}
function renderCourses(){const q=$('#course-q').value.toLowerCase(),s=$('#course-status').value,rows=courses.filter(c=>(s==='all'||c.status===s)&&`${c.title} ${c.category||''}`.toLowerCase().includes(q)),root=$('#courses');root.replaceChildren();if(!rows.length)return empty(root,'Kursus tidak ditemukan.');rows.forEach(c=>{const n=node('article','','ops-row');n.innerHTML='<div><strong></strong><span class="pill"></span><p></p></div><button class="secondary">Buka kursus</button>';n.querySelector('strong').textContent=c.title;n.querySelector('.pill').textContent=c.status;n.querySelector('p').textContent=`${c.category||'Tanpa kategori'} · ${(c.chapters||[]).length} bab`;const a=node('a','Buka kursus','button');a.href=`/admin/kursus/edit/?id=${c.id}`;n.querySelector('button').replaceWith(a);root.append(n)})}
function openCourse(c){const f=$('#course-form');f.reset();$('#course-title').textContent=c?'Edit kursus':'Tambah kursus';const x=c||{id:'',sort_order:0,status:'draft'};for(const [k,v] of Object.entries({id:x.id,title:x.title||'',slug:x.slug||'',category:x.category||'',imageUrl:x.image_url||'',description:x.description||'',sortOrder:x.sort_order,status:x.status}))ctl(f,k).value=v;$('#course-dialog').showModal()}
function courseDetail(c){const root=$('#course-detail');root.classList.remove('hidden');root.replaceChildren();const head=node('div','','detail-head');head.innerHTML='<div><span class="eyebrow">Detail kursus</span><h2></h2><p class="muted"></p></div><button class="secondary">Edit kursus</button>';head.querySelector('h2').textContent=c.title;head.querySelector('p').textContent=`${c.status} · urutan ${c.sort_order}`;head.querySelector('button').onclick=()=>openCourse(c);root.append(head);(c.chapters||[]).forEach(ch=>root.append(chapter(c,ch)));const add=node('form','','card compact-form');add.innerHTML='<h3>Tambah bab</h3><label class="field">Judul<input name="title" required maxlength="200"></label><label class="field">Urutan<input name="sortOrder" type="number" min="0" value="0" required></label><button class="primary">Tambah bab</button>';add.onsubmit=e=>{e.preventDefault();const d=data(add);run(async()=>{await call('/api/admin/member/chapters',{method:'POST',body:JSON.stringify({courseId:c.id,title:d.title,sortOrder:Number(d.sortOrder)})});await loadCourses();courseDetail(courses.find(x=>x.id===c.id))},add)};root.append(add);root.scrollIntoView({behavior:'smooth'})}
function chapter(c,ch){const box=document.createElement('details');box.className='card chapter';box.innerHTML='<summary><strong></strong><span></span></summary>';box.querySelector('strong').textContent=ch.title;box.querySelector('span').textContent=`${(ch.lessons||[]).length} materi`;const edit=node('form','','compact-form chapter-edit');edit.innerHTML='<div class="form-grid"><label class="field">Judul bab<input name="title" required maxlength="200"></label><label class="field">Urutan<input name="sortOrder" type="number" min="0" required></label></div><div class="form-actions"><button class="secondary">Simpan bab</button><button type="button" class="danger">Hapus bab</button></div>';ctl(edit,'title').value=ch.title;ctl(edit,'sortOrder').value=ch.sortOrder;edit.onsubmit=e=>{e.preventDefault();const d=data(edit);run(async()=>{await call(`/api/admin/member/chapters/${ch.id}`,{method:'PUT',body:JSON.stringify({title:d.title,sortOrder:Number(d.sortOrder)})});await loadCourses();courseDetail(courses.find(x=>x.id===c.id))},edit)};edit.querySelector('.danger').onclick=()=>confirm(`Hapus bab ${ch.title} beserta seluruh materi? Tindakan ini tidak dapat dibatalkan.`)&&run(async()=>{await call(`/api/admin/member/chapters/${ch.id}`,{method:'DELETE',body:'{}'});await loadCourses();courseDetail(courses.find(x=>x.id===c.id))});box.append(edit);(ch.lessons||[]).forEach(l=>box.append(lesson(c,ch,l)));const add=node('form','','compact-form material');add.innerHTML='<h4>Materi baru</h4><label class="field">Judul<input name="title" required maxlength="200"></label><label class="field">YouTube URL atau ID<input name="youtube" placeholder="https://youtu.be/…"></label><label class="field">Urutan<input name="sortOrder" type="number" min="0" value="0" required></label><button class="secondary">Tambah materi</button>';add.onsubmit=e=>{e.preventDefault();run(async()=>{const d=data(add),youtubeVideoId=parseYouTube(d.youtube);await call('/api/admin/member/lessons',{method:'POST',body:JSON.stringify({chapterId:ch.id,title:d.title,youtubeVideoId,sortOrder:Number(d.sortOrder)})});await loadCourses();courseDetail(courses.find(x=>x.id===c.id))},add)};box.append(add);return box}
function lesson(c,ch,l){const wrap=document.createElement('details');wrap.className='material';wrap.innerHTML='<summary><strong></strong><span class="pill"></span></summary>';wrap.querySelector('strong').textContent=l.title;wrap.querySelector('.pill').textContent=`Urutan ${l.sortOrder}`;const f=node('form','','compact-form');f.innerHTML='<label class="field">Judul<input name="title" required maxlength="200"></label><label class="field">YouTube URL atau ID<input name="youtube"></label><label class="field">Deskripsi<textarea name="description" maxlength="5000"></textarea></label><div class="form-grid"><label class="field">Urutan<input name="sortOrder" type="number" min="0" required></label><label class="check"><input name="isPreview" type="checkbox"> Pratinjau publik</label></div><div class="form-actions"><button class="primary">Simpan</button><button type="button" class="danger">Hapus</button></div><label class="field">Unggah worksheet PDF ≤ 10 MB<input class="pdf" type="file" accept="application/pdf,.pdf"></label><div class="worksheets"></div>';ctl(f,'title').value=l.title;ctl(f,'youtube').value=l.youtubeVideoId||'';ctl(f,'description').value=l.description||'';ctl(f,'sortOrder').value=l.sortOrder;ctl(f,'isPreview').checked=l.isPreview;(l.worksheets||[]).forEach(w=>{const row=node('div','','worksheet');const a=node('a',w.title);a.href=`${API}/api/admin/member/worksheets/${w.id}`;a.target='_blank';const del=node('button','Hapus PDF','danger');del.type='button';del.onclick=()=>confirm(`Hapus worksheet ${w.title}? Tindakan ini tidak dapat dibatalkan.`)&&run(async()=>{await call(`/api/admin/member/worksheets/${w.id}`,{method:'DELETE',body:'{}'});await loadCourses();courseDetail(courses.find(x=>x.id===c.id))});row.append(a,del);f.querySelector('.worksheets').append(row)});f.onsubmit=e=>{e.preventDefault();run(async()=>{const d=data(f),youtubeVideoId=parseYouTube(d.youtube);await call(`/api/admin/member/lessons/${l.id}`,{method:'PUT',body:JSON.stringify({title:d.title,youtubeVideoId,description:d.description,sortOrder:Number(d.sortOrder),isPreview:ctl(f,'isPreview').checked})});say('Materi disimpan.');await loadCourses();courseDetail(courses.find(x=>x.id===c.id))},f)};f.querySelector('.danger').onclick=()=>confirm(`Hapus materi ${l.title} beserta worksheet? Tindakan ini tidak dapat dibatalkan.`)&&run(async()=>{await call(`/api/admin/member/lessons/${l.id}`,{method:'DELETE',body:'{}'});await loadCourses();courseDetail(courses.find(x=>x.id===c.id))});f.querySelector('.pdf').onchange=e=>uploadPdf(c,l,e.target.files[0]);wrap.append(f);return wrap}
async function uploadPdf(c,l,file){await run(async()=>{if(!file||file.type!=='application/pdf'||file.size>10*1024*1024)throw Error('Pilih PDF maksimal 10 MB.');const base64=await new Promise((ok,no)=>{const r=new FileReader;r.onload=()=>ok(String(r.result).split(',')[1]);r.onerror=()=>no(Error('PDF gagal dibaca.'));r.readAsDataURL(file)});await call('/api/admin/member/worksheets',{method:'POST',body:JSON.stringify({lessonId:l.id,title:file.name.replace(/\.pdf$/i,''),fileName:file.name,base64})});say('Worksheet diunggah.');await loadCourses();courseDetail(courses.find(x=>x.id===c.id))})}
$('#course-form').onsubmit=e=>{e.preventDefault();const f=e.currentTarget,d=data(f),id=d.id;if(id&&d.status==='archived'&&!confirm(`Arsipkan kursus ${d.title}?`))return;run(async()=>{await call(id?`/api/admin/member/courses/${id}`:'/api/admin/member/courses',{method:id?'PUT':'POST',body:JSON.stringify({...d,id:undefined,sortOrder:Number(d.sortOrder)})});f.closest('dialog').close();say('Kursus disimpan.');await loadCourses()},f)};
async function loadOrders(page=orderPage){const request=++orderRequest;orderPage=page;const root=$('#orders'),d=data($('#order-filter'));root.innerHTML='<p class="card empty">Memuat pesanan…</p>';try{const qs=new URLSearchParams({...d,page:String(page),limit:'20'}),x=await call('/api/admin/member/orders?'+qs);if(request!==orderRequest)return;root.replaceChildren();if(!x.orders.length)empty(root,'Pesanan tidak ditemukan.');x.orders.forEach(o=>{const r=node('article','','ops-row');r.innerHTML='<div><strong></strong><span class="pill"></span><p></p></div><button class="secondary">Detail</button>';r.querySelector('strong').textContent=`${o.member_name||'Member'} · ${o.order_id}`;r.querySelector('.pill').textContent=o.status;r.querySelector('p').textContent=`${money(o.amount)} · ${o.plan_name||o.duration_days+' hari'} · ${wib(o.created_at)}`;r.querySelector('button').onclick=()=>openOrder(o);root.append(r)});const pages=Math.ceil(x.total/x.limit),p=$('#order-pages');p.replaceChildren();if(pages>1){const a=node('button','← Sebelumnya','secondary'),b=node('span',`Halaman ${x.page} dari ${pages}`),n=node('button','Berikutnya →','secondary');a.disabled=x.page<=1;n.disabled=x.page>=pages;a.onclick=()=>run(()=>loadOrders(x.page-1));n.onclick=()=>run(()=>loadOrders(x.page+1));p.append(a,b,n)}}catch(e){if(request===orderRequest&&!e.stale)empty(root,'Pesanan gagal dimuat.');throw e}}
function openOrder(o){$('#order-title').textContent=o.order_id;const d=$('#order-detail');d.innerHTML='<dl class="detail-grid"></dl><div class="form-actions"></div>';const fields=[['Member',`${o.member_name||'—'} · ${o.member_email||'—'}`],['Paket',`${o.plan_name||'—'} · ${o.duration_days} hari`],['Jumlah',money(o.amount)],['Status',o.status],['Dibuat',wib(o.created_at)],['Kedaluwarsa',wib(o.expires_at)],['Dibayar',wib(o.paid_at)],['Diarsipkan',wib(o.archived_at)]];const dl=d.querySelector('dl');fields.forEach(([k,v])=>{dl.append(node('dt',k),node('dd',v))});const action=d.querySelector('.form-actions');if(o.archived_at){const b=node('button','Pulihkan','secondary');b.onclick=()=>orderAction(o,'restore',b);action.append(b)}else{const b=node('button','Batalkan & arsipkan','danger');b.disabled=o.status==='paid';b.title=o.status==='paid'?'Pesanan dibayar tidak dapat dibatalkan':'';b.onclick=()=>orderAction(o,'archive',b);action.append(b)}$('#order-dialog').showModal()}
function orderAction(o,kind,button){const reason=prompt(`Alasan ${kind==='restore'?'pemulihan':'pembatalan dan arsip'}:`);if(!reason?.trim()||!confirm(`${kind==='restore'?'Pulihkan pesanan':'Batalkan pembayaran pending dan arsipkan pesanan'} ${o.order_id}?`))return;run(async()=>{await call(`/api/admin/member/orders/${o.order_id}/${kind}`,{method:'POST',body:JSON.stringify({confirm:true,reason:reason.trim()})});$('#order-dialog').close();say(kind==='restore'?'Pesanan dipulihkan.':'Pembayaran dibatalkan dan pesanan diarsipkan.');await loadOrders()},button.closest('.form-actions'))}
async function loadMembers(){const request=++memberRequest,f=$('#member-search'),d=data(f),root=$('#members');root.innerHTML='<p class="card empty">Memuat member…</p>';try{const x=await call(`/api/admin/member/members?status=${d.status}&q=${encodeURIComponent(d.q)}&page=1`);if(request!==memberRequest)return;root.replaceChildren();if(!x.members.length)return empty(root,'Member tidak ditemukan.');x.members.forEach(m=>{const r=node('article','','ops-row');r.innerHTML='<div><strong></strong><p></p></div><button class="secondary">Detail</button>';r.querySelector('strong').textContent=m.name||'Tanpa nama';r.querySelector('p').textContent=`${m.email} · akses ${wib(m.membership_expires_at)}`;r.querySelector('button').onclick=()=>run(()=>memberDetail(m.id));root.append(r)})}catch(e){if(request===memberRequest&&!e.stale)empty(root,'Member gagal dimuat.');throw e}}
async function memberDetail(id,orders='active'){const x=await call(`/api/admin/member/members/${id}?orders=${orders}`),root=$('#member-detail');root.classList.remove('hidden');root.replaceChildren(node('h2',x.account.name||x.account.email),node('p',x.account.email,'muted'),node('p',`Akses legacy seluruh katalog sampai ${wib(x.account.membership_expires_at)}`));const grants=node('div','','order-list');grants.append(node('h3','Akses kursus terpilih'));(x.selectedGrants||[]).forEach(g=>grants.append(node('p',`${g.title} · sampai ${wib(g.accessibleUntil)}`,'muted')));if(!x.selectedGrants?.length)grants.append(node('p','Tidak ada akses kursus terpilih.','muted'));root.append(grants);const tabs=node('div','','order-filters'),active=node('button','Pesanan aktif','secondary'),archived=node('button','Pesanan arsip','secondary');active.disabled=orders==='active';archived.disabled=orders==='archived';active.onclick=()=>run(()=>memberDetail(id,'active'));archived.onclick=()=>run(()=>memberDetail(id,'archived'));tabs.append(active,archived);root.append(tabs);const list=node('div','','order-list');(x.orders||[]).forEach(o=>{const row=node('article','','order-row');row.append(node('strong',o.order_id),node('span',`${money(o.amount)} · ${o.duration_days} hari · ${o.status} · ${wib(o.created_at)}`));list.append(row)});if(!x.orders?.length)list.append(node('p',orders==='active'?'Tidak ada pesanan aktif.':'Tidak ada pesanan arsip.','muted'));root.append(list);const form=node('form','','compact-form');form.innerHTML='<h3>Ubah akses manual</h3><div class="form-grid"><label class="field">Operasi<select name="operation"><option value="grant">Tambah akses</option><option value="revoke">Kurangi akses</option></select></label><label class="field">Jumlah hari<input name="days" type="number" min="1" max="365" required></label></div><label class="field">Alasan<input name="reason" maxlength="200" required></label><button class="primary">Konfirmasi perubahan</button>';form.onsubmit=e=>{e.preventDefault();const d=data(form);if(!confirm(`${d.operation==='grant'?'Tambah':'Kurangi'} akses ${d.days} hari?`))return;run(async()=>{await call(`/api/admin/member/members/${id}/access`,{method:'POST',body:JSON.stringify({...d,days:Number(d.days),confirm:true})});say('Akses member diperbarui.');await memberDetail(id,orders)},form)};root.append(form,node('h3','Riwayat akses'));(x.accessHistory||[]).forEach(h=>{const delta=Number(h.days_delta),source={payment:'Pembayaran',admin_grant:'Penambahan admin',admin_revoke:'Pengurangan admin'}[h.source_type]||h.source_type;root.append(node('p',`${wib(h.created_at)} · ${source} · ${delta>0?'+':''}${delta} hari · ${wib(h.previous_expires_at)} → ${wib(h.resulting_expires_at)} · ${h.reason||'Tanpa alasan'} · ${h.actor||'sistem'}`,'history-row'))});root.scrollIntoView({behavior:'smooth'})}
async function loadEvaluations(){const root=$('#evaluations');root.replaceChildren(node('p','Memuat karya…','card empty'));const x=await call('/api/admin/member-program/artworks');const artworks=x.artworks||[];root.replaceChildren();if(!artworks.length)return empty(root,'Belum ada karya untuk dievaluasi.');artworks.forEach(a=>{const card=node('article','','card evaluation-card'),img=document.createElement('img'),title=node('h2',a.title||'Karya tanpa judul'),meta=node('p',[a.memberName||a.member_name,a.courseTitle||a.course_title].filter(Boolean).join(' · '),'muted'),form=node('form','','field'),label=node('label','Masukan untuk murid'),text=document.createElement('textarea'),save=node('button','Simpan feedback','primary');img.src=`${API}/api/admin/member-program/artworks/${a.id}/image`;img.alt=`Karya ${a.title||'murid'}`;img.loading='lazy';text.name='feedback';text.maxLength=1500;text.required=true;text.value=a.feedback||'';form.append(label,text,save);form.onsubmit=e=>{e.preventDefault();run(async()=>{await call(`/api/admin/member-program/artworks/${a.id}/feedback`,{method:'PUT',body:JSON.stringify({feedback:text.value.trim()})});say('Feedback disimpan.')},form)};card.append(img,title,meta,form);root.append(card)})}
$('#refresh-evaluations').onclick=()=>run(loadEvaluations);
$('#login-form').onsubmit=e=>{e.preventDefault();const f=e.currentTarget;run(async()=>{await call('/api/admin/login',{method:'POST',body:JSON.stringify(data(f))});f.reset();await boot()},f)};$('#logout').onclick=()=>run(async()=>{try{await call('/api/admin/logout',{method:'POST',body:'{}'})}finally{loggedOut()}});$$('[data-view]').forEach(b=>b.onclick=()=>run(()=>show(b.dataset.view)));$$('[data-open]').forEach(b=>b.onclick=()=>b.dataset.open==='plan-dialog'?openPlan():openCourse());$$('dialog .close').forEach(b=>b.onclick=()=>b.closest('dialog').close());$$('dialog').forEach(d=>d.addEventListener('click',e=>{if(e.target===d)d.close()}));$('#plan-q').oninput=renderPlans;$('#plan-status').onchange=renderPlans;$('#course-q').oninput=renderCourses;$('#course-status').onchange=renderCourses;$('#order-filter').onsubmit=e=>{e.preventDefault();run(()=>loadOrders(1))};$('#member-search').onsubmit=e=>{e.preventDefault();run(loadMembers)};boot();
</script></body></html>