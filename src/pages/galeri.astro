---
import '../styles.css';
const api = import.meta.env.PUBLIC_API_URL || 'https://api.artstudionala.com';
---
<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Galeri Karya · Artstudio Nala</title><meta name="description" content="Karya member yang disetujui untuk ditampilkan di galeri publik"></head><body data-api={api}><header class="site-header"><div class="wrap header-inner"><a class="brand" href="/"><img src="/nala-logo.png" alt="Artstudio Nala"></a><nav class="nav"><a class="button secondary" href="/">Beranda</a><a class="button" href="/portal">Portal member</a></nav></div></header><main class="wrap section"><span class="eyebrow">Galeri publik</span><h1>Karya keluarga Nala</h1><p class="muted">Hanya karya dengan izin pemilik dan persetujuan moderator yang ditampilkan. Data akun tidak dipublikasikan.</p><p id="status" class="message" role="status"></p><section id="gallery" class="grid catalog"></section></main><script>const API=document.body.dataset.api,root=document.querySelector('#gallery'),status=document.querySelector('#status');fetch(`${API}/api/member-public/gallery`).then(async r=>{const x=await r.json();if(!r.ok)throw Error(x.message||'Galeri gagal dimuat');if(!x.items.length)status.textContent='Belum ada karya publik.';x.items.forEach(a=>{const card=document.createElement('article'),img=document.createElement('img'),title=document.createElement('h2');card.className='card';img.className='course-image';img.src=`${API}/api/member-public/gallery/${a.id}/image`;img.alt=`Karya ${a.title}`;title.textContent=a.title;card.append(img,title);root.append(card)})}).catch(e=>{status.textContent=e.message;status.className='message error'})</script></body></html>