---
import '../styles.css';
const api = import.meta.env.PUBLIC_API_URL || 'https://api.artstudionala.com';
---
<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Galeri Karya · Artstudio Nala</title><meta name="description" content="Karya member yang disetujui untuk ditampilkan di galeri publik"></head><body class="gallery-page" data-api={api}><header class="site-header"><div class="wrap header-inner"><a class="brand" href="/"><img src="/nala-logo.png" alt="Artstudio Nala"></a><nav class="nav"><a class="button secondary" href="/">Beranda</a><a class="button" href="/portal">Portal member</a></nav></div></header><main class="gallery-main" data-structure="discovery-gallery"><header class="gallery-hero"><div class="wrap"><span class="eyebrow">Galeri publik terkurasi</span><h1>Temukan inspirasi dari keluarga Nala.</h1><p>Karya pilihan dari proses belajar member. Identitas pribadi tetap terlindungi.</p></div></header><section class="wrap gallery-discovery" aria-labelledby="gallery-heading"><div class="section-head"><div><span class="eyebrow">Jelajahi karya</span><h2 id="gallery-heading">Karya terbaru</h2></div><div class="gallery-filters"><a class="button secondary" href="/portal?view=program">Kirim karya</a></div></div><p class="privacy-note">Hanya karya berizin dan disetujui moderator yang tampil. Data akun tidak dipublikasikan.</p><p id="status" class="message" role="status" aria-live="polite"></p><section id="gallery" class="grid catalog gallery-grid" aria-live="polite" aria-busy="true"></section><aside class="report-note"><strong>Menemukan karya yang tidak sesuai?</strong><span>Laporkan melalui portal member agar tim dapat meninjaunya.</span><a href="/portal?view=program">Buka pusat bantuan</a></aside></section></main><script>
const API=document.body.dataset.api,root=document.querySelector('#gallery'),status=document.querySelector('#status');
async function load(){root.setAttribute('aria-busy','true');root.replaceChildren();status.className='message';status.textContent='Memuat karya…';try{const r=await fetch(`${API}/api/member-public/gallery`),x=await r.json().catch(()=>({message:'Respons galeri tidak valid.'}));if(!r.ok)throw Error(x.message||'Galeri gagal dimuat');status.textContent=x.items.length?'':'Belum ada karya publik. Kunjungi portal untuk mengunggah karya.';x.items.forEach(a=>{const card=document.createElement('article'),img=document.createElement('img'),title=document.createElement('h2');card.className='card';img.className='course-image';img.src=`${API}/api/member-public/gallery/${a.id}/image`;img.alt=`Karya ${a.title}`;img.loading='lazy';img.onerror=()=>img.replaceWith(Object.assign(document.createElement('div'),{className:'course-placeholder',textContent:'Gambar tidak tersedia'}));title.textContent=a.title;card.append(img,title);root.append(card)})}catch(e){status.textContent=e.message+' ';status.className='message error';const b=document.createElement('button');b.className='secondary';b.textContent='Coba lagi';b.onclick=load;status.append(b)}finally{root.setAttribute('aria-busy','false')}}load();
</script></body></html>