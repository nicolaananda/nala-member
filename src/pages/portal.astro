---
import '../styles.css';
const api = import.meta.env.PUBLIC_API_URL || 'https://api.artstudionala.com';
---
<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Portal Member · Artstudio Nala</title><meta name="description" content="Akun, kelas, dan pesanan member Artstudio Nala"></head><body class="learner-shell" data-api={api}><header class="site-header"><div class="wrap header-inner"><a class="brand" href="/" aria-label="Beranda Artstudio Nala"><img src="/nala-logo.png" alt="Artstudio Nala"><span><strong>Ruang Belajar</strong><small>Artstudio Nala</small></span></a><nav id="nav" class="nav" aria-label="Portal member"><button data-view="dashboard"><span aria-hidden="true">▶</span> Beranda</button><button data-view="discover"><span aria-hidden="true">⌕</span> Cari & kalender</button><button data-view="catalog"><span aria-hidden="true">▦</span> Katalog</button><button data-view="program"><span aria-hidden="true">✦</span> Karyaku</button><button data-view="orders"><span aria-hidden="true">◇</span> Pesanan</button><button data-view="rewards"><span aria-hidden="true">★</span> Reward</button><button data-view="account"><span aria-hidden="true">○</span> Akun</button><button id="logout" class="hidden">Keluar</button></nav></div></header><main class="member-layout lms-shell"><aside class="learning-sidebar" aria-label="Navigasi belajar"><a class="brand" href="/"><img src="/nala-logo.png" alt=""><span><strong>Nala LMS</strong><small>Ruang belajar</small></span></a><nav><button data-view="dashboard">Ikhtisar</button><button data-view="catalog">Katalog kelas</button><button data-view="discover">Cari & kalender</button><button data-view="program">Karya & sertifikat</button><button data-view="orders">Pesanan</button><button data-view="account">Akun</button></nav><p class="sidebar-help"><strong>Butuh bantuan?</strong><span>Lihat materi atau kirim pertanyaan dari ruang kelas.</span></p></aside><div class="learning-main"><p id="notice" class="message" role="status" aria-live="polite"></p><section id="auth" class="auth-shell hidden"><form id="login-form" class="card"><span class="eyebrow">Selamat datang kembali</span><h1>Masuk ke akun</h1><label class="field">Email<input name="email" type="email" autocomplete="email" maxlength="254" required></label><label class="field">Password<input name="password" type="password" autocomplete="current-password" minlength="10" maxlength="200" required></label><div class="form-actions"><button class="primary">Masuk</button><button type="button" class="secondary" data-auth="register">Buat akun</button></div><button type="button" class="secondary" id="forgot" style="margin-top:.7rem">Lupa password</button></form><form id="register-form" class="card hidden"><span class="eyebrow">Akun keluarga</span><h1>Buat akun</h1><label class="field">Nama orang tua<input name="name" autocomplete="name" minlength="2" maxlength="100" required></label><label class="field">Email<input name="email" type="email" autocomplete="email" maxlength="254" required></label><label class="field">Password<input name="password" type="password" autocomplete="new-password" minlength="10" maxlength="200" required></label><p class="muted">Gunakan minimal 10 karakter. Tautan verifikasi akan dikirim ke email.</p><div class="form-actions"><button class="primary">Daftar</button><button type="button" class="secondary" data-auth="login">Sudah punya akun</button></div></form><form id="resend-form" class="card hidden"><span class="eyebrow">Verifikasi email</span><h1>Kirim ulang tautan</h1><label class="field">Email<input name="email" type="email" autocomplete="email" required></label><div class="form-actions"><button class="primary">Kirim tautan</button><button type="button" class="secondary" data-auth="login">Kembali masuk</button></div></form></section><section id="app" class="hidden"><span id="member-name" class="hidden">—</span><span id="member-email" class="hidden"></span><span id="member-access" class="hidden"></span><button id="renew" class="hidden" disabled></button><section id="dashboard-view" class="hidden dashboard-overview" data-structure="lms-dashboard"><header class="member-home-head"><div><span class="eyebrow">Ruang belajar Nala</span><h1>Halo, <span id="child-name">Teman Nala</span>!</h1><p class="muted">Pilih kelas yang ingin dipelajari hari ini.</p></div><div class="home-status"><strong id="active-level" class="level-badge">Pilih level</strong><span id="home-access" class="muted"></span></div></header><section id="feedback-notifications" aria-live="polite"></section><div class="home-levels" role="group" aria-label="Pilih level"><button class="level-card" data-level="Beginner"><strong>Beginner</strong></button><button class="level-card" data-level="Intermediate"><strong>Intermediate</strong></button><button class="level-card" data-level="Advanced"><strong>Advanced</strong></button></div><section class="parent-dashboard" aria-label="Ringkasan belajar anak"><div id="family-summary" class="family-summary" aria-live="polite"></div><div class="family-columns"><section><h2>Kelas aktif</h2><div id="continue-learning" class="family-classes"></div></section><aside><section id="latest-work" class="card"></section><section id="family-reminders" class="card"></section><section id="next-class" class="card"></section></aside></div></section></section><section id="catalog-view" class="hidden"><div class="section-head compact"><div><span class="eyebrow">Katalog kelas</span><h2 id="level-heading">Pilih Kelas</h2></div></div><div class="toolbar"><label class="field">Cari kelas<input id="search" type="search" placeholder="Cari kelas"></label><label class="field">Kategori<select id="category"><option value="">Semua kategori</option></select></label><label class="field">Tampilan<select id="favourite-filter"><option value="">Semua kelas</option><option value="yes">Favorit</option></select></label></div><div id="catalog" class="home-course-grid" aria-live="polite"></div><div class="form-actions" aria-label="Paginasi kelas"><button id="catalog-prev" class="secondary">Sebelumnya</button><span id="catalog-page" class="muted"></span><button id="catalog-next" class="secondary">Berikutnya</button></div></section><section id="course-view" class="hidden"><button id="back-catalog" class="secondary">← Semua kelas</button><div class="section-head"><div><span id="course-category" class="eyebrow"></span><h2 id="course-title"></h2><p id="course-description" class="muted"></p></div></div><div class="course-view course-workspace" data-structure="lesson-workspace"><details class="lesson-directory" open><summary>Daftar materi</summary><aside id="course-lessons" class="card course-sidebar" aria-label="Daftar materi"></aside></details><article class="card lesson-player"><header class="workspace-label"><span>Ruang materi</span><small>Video · latihan · catatan</small></header><div id="lesson-content" class="empty">Pilih materi untuk mulai belajar.</div></article></div></section><section id="discover-view" class="hidden"><div class="section-head"><div><span class="eyebrow">Belajar</span><h1>Cari materi & kalender</h1></div></div><form id="portal-search" class="filters"><label class="field">Cari materi yang dapat diakses<input name="q" type="search" minlength="2" maxlength="100" required></label><button class="primary">Cari</button></form><div id="portal-search-results" class="ops-list" aria-live="polite"></div><h2>Kalender belajar</h2><div id="learning-calendar" class="ops-list" aria-live="polite"></div></section><section id="account-view" class="hidden"><div class="section-head"><div><span class="eyebrow">Profil</span><h2>Data akun</h2></div></div><div class="account-grid"><form id="profile-form" class="card"><h3>Nama profil</h3><label class="field">Nama orang tua<input name="name" minlength="2" maxlength="100" required></label><button class="primary">Simpan nama</button></form><form id="preferences-form" class="card"><h3>Notifikasi</h3><label><input id="renewal-emails" type="checkbox"> Kirim pengingat perpanjangan</label><label><input id="notification-in-app" type="checkbox"> Notifikasi di aplikasi</label><label><input id="notification-email" type="checkbox"> Email (provider dapat dinonaktifkan)</label><label><input id="notification-whatsapp" type="checkbox"> WhatsApp (provider opsional)</label><button class="primary">Simpan preferensi</button></form><article class="card"><h3>Sesi aktif</h3><div id="sessions" aria-live="polite"></div><button id="refresh-sessions" class="secondary">Perbarui sesi</button></article><article class="card"><h3>Keanggotaan</h3><p id="account-access"></p><section class="card"><h2>Poin Nala</h2><strong id="points-balance">—</strong><div id="points-history" class="stack" aria-live="polite"></div></section><p class="muted">Pembayaran QRIS diproses oleh penyedia pembayaran. Akses aktif setelah pembayaran terverifikasi.</p><button class="primary" data-buy disabled>Pembayaran belum tersedia</button><button class="secondary account-orders" data-view="orders">Lihat Pesanan</button></article></div></section><section id="orders-view" class="hidden"><div class="section-head"><div><span class="eyebrow">Pembayaran</span><h2>Riwayat pesanan</h2></div><button id="refresh-orders" class="secondary">Perbarui</button></div><div id="orders" class="orders" aria-live="polite"></div></section><section id="rewards-view" class="hidden"><div class="section-head"><div><span class="eyebrow">Poin Nala</span><h1>Reward</h1><strong id="reward-balance">—</strong></div><button id="refresh-rewards" class="secondary">Perbarui</button></div><div id="rewards" class="reward-grid" aria-live="polite"></div><h2>Riwayat penukaran</h2><div id="redemptions" class="ops-list" aria-live="polite"></div></section><section id="program-view" class="hidden"><div class="section-head"><div><span class="eyebrow">Program Member</span><h1>Kreasi & pencapaian</h1></div></div><div class="filter-row" role="tablist"><button class="secondary" data-program="access">Akses</button><button class="secondary" data-program="qa">Tanya jawab</button><button class="secondary" data-program="art">Karya</button><button class="secondary" data-program="challenges">Tantangan</button><button class="secondary" data-program="gallery">Galeri</button><button class="secondary" data-program="paths">Jalur belajar</button><button class="secondary" data-program="badges">Badge</button><button class="secondary" data-program="certs">Sertifikat</button></div><div id="program-content" class="card"></div></section>
</section></div><nav class="mobile-learning-nav" aria-label="Navigasi utama mobile"><button data-view="dashboard" aria-label="Beranda"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 11 12 3l9 8v10h-6v-6H9v6H3Z"/></svg><span>Beranda</span></button><button data-view="discover" aria-label="Cari"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span>Cari</span></button><button data-view="catalog" aria-label="Kelas"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 5.5A3.5 3.5 0 0 1 7.5 2H20v17H7.5A3.5 3.5 0 0 0 4 22Z"/><path d="M4 5.5V22"/></svg><span>Kelas</span></button><button data-view="program" aria-label="Karya"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m4 20 4.5-1 10-10-3.5-3.5-10 10Z"/><path d="m13.5 7 3.5 3.5M4 20h16"/></svg><span>Karya</span></button><button data-view="rewards" aria-label="Hadiah"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 10h18v11H3ZM2 6h20v4H2Z"/><path d="M12 6v15M12 6H8.5a2.5 2.5 0 1 1 2.5-2.5ZM12 6h3.5A2.5 2.5 0 1 0 13 3.5Z"/></svg><span>Hadiah</span></button><button data-view="account" aria-label="Akun"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg><span>Akun</span></button></nav></main><dialog id="checkout-dialog"><form id="checkout-form" class="dialog-card"><header><div><span class="eyebrow">Pembayaran kelas</span><h2>Gunakan voucher?</h2></div><button type="button" class="icon close" aria-label="Tutup">×</button></header><p class="muted">Masukkan kode voucher jika ada. Kosongkan untuk langsung membayar dengan QRIS.</p><label class="field">Kode voucher (opsional)<input name="code" maxlength="200" autocomplete="off" placeholder="Contoh: NALA-XXXX"></label><footer><button type="button" class="secondary close">Batal</button><button class="primary">Lanjutkan</button></footer></form></dialog><script>
const API=(document.body.dataset.api||'').trim();const $=s=>document.querySelector(s);const notice=$('#notice');let member=null,courses=[],orders=[],active=false,currentCourse=null,selectedLevel='',checkout={enabled:false,plans:[]},checkoutTarget=null,pollTimer=null,pollCount=0,paymentBusy=false,catalogPage=1,playerCleanup=()=>{};const PAGE_SIZE=9;
const say=(text,error=false)=>{notice.textContent=text||'';notice.className=`message ${error?'error':'success'}`};
const req=async(path,init={})=>{const r=await fetch(API+'/api/member'+path,{credentials:'include',signal:AbortSignal.timeout(20000),headers:{'Content-Type':'application/json'},...init});const data=await r.json().catch(()=>({message:'Respons server tidak valid.'}));if(!r.ok)throw Object.assign(new Error(data.message||'Permintaan gagal.'),{status:r.status});return data};
const el=(tag,attrs={},text='')=>{const n=document.createElement(tag);Object.entries(attrs).forEach(([k,v])=>k==='class'?n.className=v:k.startsWith('data-')?n.setAttribute(k,v):n[k]=v);if(text)n.textContent=text;return n};
function authView(){location.replace('/login?next=%2Fportal')}
function show(view,replace=false){if(!member)return authView();clearTimeout(pollTimer);playerCleanup();const views=['dashboard','account','orders','rewards','program'].concat(['discover','catalog','course']);views.forEach(x=>$(`#${x}-view`).classList.toggle('hidden',x!==view));document.querySelectorAll('[data-view]').forEach(b=>b.setAttribute('aria-current',b.dataset.view===view?'page':'false'));history[replace?'replaceState':'pushState']({},'',`/portal?view=${view}`);if(view==='orders')loadOrders();if(view==='rewards')loadRewards();if(view==='discover')loadDiscover();if(view==='dashboard'){loadDashboard();loadNotifications()}if(view==='account'){loadSessions();loadPoints()}if(view==='program')program('art')}
function accessText(){const available=courses.filter(c=>c.accessible);if(available.length){const dates=available.map(c=>c.accessibleUntil&&new Date(c.accessibleUntil)).filter(Boolean),until=dates.length?new Date(Math.max(...dates)).toLocaleString('id-ID',{dateStyle:'long',timeStyle:'short',timeZone:'Asia/Jakarta'})+' WIB':'';return `${available.length} kelas dapat diakses${until?` · akses terlama sampai ${until}`:''}`}if(!member?.membership_expires_at)return 'Belum ada kelas aktif';const d=new Date(member.membership_expires_at);return d>new Date()?`Akses legacy seluruh katalog sampai ${d.toLocaleString('id-ID',{dateStyle:'long',timeStyle:'short',timeZone:'Asia/Jakarta'})} WIB`:`Akses legacy seluruh katalog berakhir ${d.toLocaleDateString('id-ID',{timeZone:'Asia/Jakarta'})}`}
async function bootstrap(){try{checkout=await req('/checkout-capability');member=(await req('/me')).member;selectedLevel=member.learning_level?member.learning_level[0].toUpperCase()+member.learning_level.slice(1):'';$('#auth').classList.add('hidden');$('#nav').classList.remove('hidden');$('#app').classList.remove('hidden');$('#logout').classList.remove('hidden');$('#member-name').textContent=member.name;$('#child-name').textContent=member.name;$('#active-level').textContent=selectedLevel?`Level ${selectedLevel}`:'Pilih level sebelum membeli';$('#member-email').textContent=member.email;$('#member-access').textContent=accessText();$('#account-access').textContent=accessText();$('#profile-form [name=name]').value=member.name;$('#renewal-emails').checked=member.renewal_emails_enabled!==false;const data=await req('/catalog');courses=data.courses||[];active=Boolean(data.active);$('#member-access').textContent=accessText();$('#account-access').textContent=accessText();$('#home-access').textContent=accessText();renderCheckout();renderFilters();renderCatalog();loadNotifications();req('/program/notification-preferences').then(x=>{$('#notification-in-app').checked=x.preferences.inApp;$('#notification-email').checked=x.preferences.email;$('#notification-whatsapp').checked=x.preferences.whatsapp}).catch(()=>{});const wanted=new URLSearchParams(location.search).get('view');show(['dashboard','discover','catalog','account','orders','rewards','program'].includes(wanted)?wanted:'dashboard',true)}catch(e){if(e.status===401){member=null;$('#logout').classList.add('hidden');authView(new URLSearchParams(location.search).get('view')==='register'?'register':'login')}else{say(`${e.message} Muat ulang untuk mencoba lagi.`,true);$('#auth').classList.add('hidden');$('#app').classList.remove('hidden')}}}
async function loadNotifications(){const root=$('#feedback-notifications');try{const x=await req('/program/notifications');root.replaceChildren();for(const a of x.notifications||[]){const b=el('button',{class:'feedback-alert'});b.append(el('strong',{},a.title),el('span',{},a.body),el('small',{},a.kind==='announcement'?'Buka pengumuman':'Lihat evaluasi'));b.onclick=async()=>{await req(`/program/notifications/${a.id}/read`,{method:'PUT',body:'{}'});if(a.kind==='announcement'){location.href=a.href;return}show('program');await program('art');const artworkId=new URL(a.href,location.origin).searchParams.get('artwork');document.getElementById(`artwork-${artworkId}`)?.scrollIntoView({behavior:'smooth',block:'center'})};root.append(b)}}catch{root.textContent='Notifikasi belum dapat dimuat.'}}
async function loadDashboard(){try{const data=await req('/dashboard'),root=$('#continue-learning'),summary=$('#family-summary');summary.replaceChildren();[['Kelas aktif',data.courses.length],['Progress keseluruhan',`${data.overall_progress}%`],['Poin Nala',data.point_balance]].forEach(([label,value])=>summary.append(el('article',{class:'card summary-card'},`${label}: ${value}`)));root.replaceChildren();for(const x of data.courses){const card=el('article',{class:'card family-class'}),body=el('div',{}),bar=el('progress',{max:100,value:x.progress_percent,'aria-label':`Progress ${x.title} ${x.progress_percent}%`}),b=el('button',{class:'primary'},x.progress_percent===100?'Lihat kelas':'Lanjutkan');if(x.image_url)card.append(el('img',{src:x.image_url,alt:'',class:'course-image',loading:'lazy'}));body.append(el('div',{class:'course-actions'},''),el('h3',{},x.title),bar,el('p',{class:'muted'},`${x.progress_percent}% · ${x.completed_count}/${x.material_count} materi`));if(x.progress_percent===100)body.prepend(el('span',{class:'status success'},'Selesai'));b.onclick=()=>{const c=courses.find(c=>String(c.id)===String(x.id));if(c)openCourse(c)};body.append(b);card.append(body);root.append(card)}if(!data.courses.length)root.append(el('p',{class:'card empty'},'Belum ada kelas aktif.'));const work=$('#latest-work');work.replaceChildren(el('h3',{},'Karya terbaru'));work.append(el('p',{},data.latest_artwork?data.latest_artwork.title:'Belum ada karya'),el('p',{class:'muted'},data.latest_artwork?(data.latest_artwork.reviewed?`Sudah ditinjau${data.latest_artwork.score!=null?` · nilai ${data.latest_artwork.score}`:''}`:'Menunggu evaluasi'):'Unggah karya dari ruang kelas.'));const reminders=$('#family-reminders');reminders.replaceChildren(el('h3',{},'Perlu perhatian'));(data.reminders.length?data.reminders:[{text:'Semua sudah beres.'}]).forEach(x=>reminders.append(el('p',{},x.text)));const next=$('#next-class');next.replaceChildren(el('h3',{},'Rekomendasi berikutnya'));next.append(el('p',{},data.recommendation?.title||'Selesaikan kelas aktif lebih dahulu.'),el('p',{class:'muted'},data.recommendation?.reason||''));if(data.recommendation){const b=el('button',{class:'secondary'},'Lihat kelas');b.onclick=()=>show('catalog');next.append(b)}const reward=el('button',{class:'primary'},'Lihat hadiah');reward.onclick=()=>show('rewards');summary.lastElementChild.append(reward)}catch(e){say(e.message,true)}}
function renderFilters(){const select=$('#category'),current=select.value;while(select.options.length>1)select.remove(1);[...new Set(courses.map(c=>c.category).filter(Boolean))].sort().forEach(x=>select.add(new Option(x,x)));select.value=current}
function coursePlan(course){return checkout.plans?.find(p=>p.accessMode==='selected'&&(p.courses||[]).some(c=>String(c.id)===String(course.id)))||checkout.plans?.find(p=>p.accessMode==='legacy_all')||null}
function renderCatalog(){const root=$('#catalog'),q=$('#search').value.trim().toLowerCase(),cat=$('#category').value,fav=$('#favourite-filter').value;root.replaceChildren();const filtered=courses.filter(c=>(!cat||c.category===cat)&&(!fav||c.favourite)&&`${c.title} ${c.description||''}`.toLowerCase().includes(q)),pages=Math.max(1,Math.ceil(filtered.length/PAGE_SIZE));catalogPage=Math.min(catalogPage,pages);const list=filtered.slice((catalogPage-1)*PAGE_SIZE,catalogPage*PAGE_SIZE);$('#catalog-page').textContent=`Halaman ${catalogPage} dari ${pages}`;$('#catalog-prev').disabled=catalogPage===1;$('#catalog-next').disabled=catalogPage===pages;if(!list.length){root.append(el('div',{class:'card empty'},'Tidak ada kelas yang cocok dengan pencarian atau filter.'));return}list.forEach(c=>{const plan=coursePlan(c),card=el('article',{class:'card course-card'});if(c.image_url){const img=el('img',{class:'course-image',src:c.image_url,alt:`Thumbnail ${c.title}`,loading:'lazy'});img.addEventListener('error',()=>img.replaceWith(el('div',{class:'course-placeholder'},'🎨')));card.append(img)}else card.append(el('div',{class:'course-placeholder'},'🎨'));const body=el('div',{class:'course-body'});body.append(el('span',{class:'pill'},c.learningLevel||c.category||'Kelas'),el('h3',{},c.title),el('p',{class:'muted course-copy'},c.description||'Materi kreatif dari Artstudio Nala.'));const price=el('strong',{class:'course-price'},c.accessible?'Sudah dibeli':plan?`Rp${Number(plan.price).toLocaleString('id-ID')}`:'Harga belum tersedia');const favorite=el('button',{class:'secondary','aria-pressed':Boolean(c.favourite)},c.favourite?'♥ Favorit':'♡ Simpan');favorite.disabled=!c.accessible;favorite.onclick=async()=>{favorite.disabled=true;try{await req(`/favourites/${c.id}`,{method:'PUT',body:JSON.stringify({favourite:!c.favourite})});c.favourite=!c.favourite;renderCatalog()}catch(e){favorite.disabled=false;say(e.message,true)}};body.append(favorite);const open=el('button',{class:'primary'},c.accessib