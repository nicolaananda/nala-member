---
import '../styles.css';
const api = import.meta.env.PUBLIC_API_URL || 'https://api.artstudionala.com';
---
<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Portal Member · Artstudio Nala</title><meta name="description" content="Akun, kelas, dan pesanan member Artstudio Nala"></head><body data-api={api}><header class="site-header"><div class="wrap header-inner"><a class="brand" href="/" aria-label="Beranda Artstudio Nala"><img src="/nala-logo.png" alt="Artstudio Nala"></a><nav id="nav" class="nav" aria-label="Portal member"><button data-view="dashboard">Lanjut belajar</button><button data-view="catalog">Kelas</button><button data-view="account">Akun</button><button data-view="orders">Pesanan</button><button data-view="program">Program</button><button id="logout" class="hidden">Keluar</button></nav></div></header><main class="wrap member-layout"><p id="notice" class="message" role="status" aria-live="polite"></p><section id="auth" class="auth-shell hidden"><form id="login-form" class="card"><span class="eyebrow">Selamat datang kembali</span><h1>Masuk ke akun</h1><label class="field">Email<input name="email" type="email" autocomplete="email" maxlength="254" required></label><label class="field">Password<input name="password" type="password" autocomplete="current-password" minlength="10" maxlength="200" required></label><div class="form-actions"><button class="primary">Masuk</button><button type="button" class="secondary" data-auth="register">Buat akun</button></div><button type="button" class="secondary" id="forgot" style="margin-top:.7rem">Lupa password</button></form><form id="register-form" class="card hidden"><span class="eyebrow">Akun keluarga</span><h1>Buat akun</h1><label class="field">Nama orang tua<input name="name" autocomplete="name" minlength="2" maxlength="100" required></label><label class="field">Email<input name="email" type="email" autocomplete="email" maxlength="254" required></label><label class="field">Password<input name="password" type="password" autocomplete="new-password" minlength="10" maxlength="200" required></label><p class="muted">Gunakan minimal 10 karakter. Tautan verifikasi akan dikirim ke email.</p><div class="form-actions"><button class="primary">Daftar</button><button type="button" class="secondary" data-auth="login">Sudah punya akun</button></div></form><form id="resend-form" class="card hidden"><span class="eyebrow">Verifikasi email</span><h1>Kirim ulang tautan</h1><label class="field">Email<input name="email" type="email" autocomplete="email" required></label><div class="form-actions"><button class="primary">Kirim tautan</button><button type="button" class="secondary" data-auth="login">Kembali masuk</button></div></form></section><section id="app" class="hidden"><div class="summary"><article class="card"><span class="muted">Akun</span><strong id="member-name">—</strong><span id="member-email" class="muted"></span></article><article class="card"><span class="muted">Status akses</span><strong id="member-access">Memuat…</strong><button id="renew" class="primary" style="margin-top:.7rem" disabled>Pembayaran belum tersedia</button></article></div><section id="dashboard-view" class="hidden"><div class="section-head"><div><span class="eyebrow">Aktivitas tersimpan</span><h2>Lanjut belajar</h2><p class="muted">Posisi video membantu melanjutkan tontonan; bukan bukti penguasaan materi.</p></div></div><div id="continue-learning" class="grid catalog" aria-live="polite"></div></section><section id="catalog-view"><div class="section-head"><div><span class="eyebrow">Kelas Nala</span><h2>Pilih karya berikutnya</h2></div></div><div class="toolbar"><label class="field">Cari kelas<input id="search" type="search" placeholder="Judul atau deskripsi"></label><label class="field">Kategori<select id="category"><option value="">Semua kategori</option></select></label><label class="field">Tampilan<select id="favourite-filter"><option value="">Semua kelas</option><option value="yes">Favorit</option></select></label></div><div id="catalog" class="grid catalog" aria-live="polite"></div><div class="form-actions" aria-label="Paginasi kelas"><button id="catalog-prev" class="secondary">Sebelumnya</button><span id="catalog-page" class="muted"></span><button id="catalog-next" class="secondary">Berikutnya</button></div></section><section id="course-view" class="hidden"><button id="back-catalog" class="secondary">← Semua kelas</button><div class="section-head"><div><span id="course-category" class="eyebrow"></span><h2 id="course-title"></h2><p id="course-description" class="muted"></p></div></div><div class="course-view"><aside id="course-lessons" class="card course-sidebar" aria-label="Daftar materi"></aside><article class="card"><div id="lesson-content" class="empty">Pilih materi untuk mulai belajar.</div></article></div></section><section id="account-view" class="hidden"><div class="section-head"><div><span class="eyebrow">Profil</span><h2>Data akun</h2></div></div><div class="account-grid"><form id="profile-form" class="card"><h3>Nama profil</h3><label class="field">Nama orang tua<input name="name" minlength="2" maxlength="100" required></label><button class="primary">Simpan nama</button></form><form id="preferences-form" class="card"><h3>Email</h3><label><input id="renewal-emails" type="checkbox"> Kirim pengingat perpanjangan</label><button class="primary">Simpan preferensi</button></form><article class="card"><h3>Sesi aktif</h3><div id="sessions" aria-live="polite"></div><button id="refresh-sessions" class="secondary">Perbarui sesi</button></article><article class="card"><h3>Keanggotaan</h3><p id="account-access"></p><p class="muted">Pembayaran QRIS diproses oleh penyedia pembayaran. Akses aktif setelah pembayaran terverifikasi.</p><button class="primary" data-buy disabled>Pembayaran belum tersedia</button></article></div></section><section id="orders-view" class="hidden"><div class="section-head"><div><span class="eyebrow">Pembayaran</span><h2>Riwayat pesanan</h2></div><button id="refresh-orders" class="secondary">Perbarui</button></div><div id="orders" class="orders" aria-live="polite"></div></section><section id="program-view" class="hidden"><div class="section-head"><div><span class="eyebrow">Program Member</span><h1>Kreasi & pencapaian</h1></div></div><div class="filter-row" role="tablist"><button class="secondary" data-program="access">Akses</button><button class="secondary" data-program="qa">Tanya jawab</button><button class="secondary" data-program="art">Karya</button><button class="secondary" data-program="challenges">Tantangan</button><button class="secondary" data-program="certs">Sertifikat</button></div><div id="program-content" class="card"></div></section>
</section></main><script>
const API=document.body.dataset.api;const $=s=>document.querySelector(s);const notice=$('#notice');let member=null,courses=[],orders=[],active=false,checkout={enabled:false,plans:[]},pollTimer=null,pollCount=0,catalogPage=1,playerCleanup=()=>{};const PAGE_SIZE=9;
const say=(text,error=false)=>{notice.textContent=text||'';notice.className=`message ${error?'error':'success'}`};
const req=async(path,init={})=>{const r=await fetch(API+'/api/member'+path,{credentials:'include',headers:{'Content-Type':'application/json'},...init});const data=await r.json().catch(()=>({message:'Respons server tidak valid.'}));if(!r.ok)throw new Error(data.message||'Permintaan gagal.');return data};
const el=(tag,attrs={},text='')=>{const n=document.createElement(tag);Object.entries(attrs).forEach(([k,v])=>k==='class'?n.className=v:k.startsWith('data-')?n.setAttribute(k,v):n[k]=v);if(text)n.textContent=text;return n};
function authView(name){$('#auth').classList.remove('hidden');$('#app').classList.add('hidden');['login','register','resend'].forEach(x=>$(`#${x}-form`).classList.toggle('hidden',x!==name));history.replaceState({},'',`/portal?view=${name}`)}
function show(view){if(!member)return authView(view==='register'?'register':'login');clearTimeout(pollTimer);playerCleanup();['dashboard','catalog','course','account','orders','program'].forEach(x=>$(`#${x}-view`).classList.toggle('hidden',x!==view));document.querySelectorAll('#nav [data-view]').forEach(b=>b.setAttribute('aria-current',b.dataset.view===view?'page':'false'));history.replaceState({},'',`/portal?view=${view}`);if(view==='orders')loadOrders();if(view==='dashboard')loadDashboard();if(view==='account')loadSessions();if(view==='program')program('access')}
function accessText(){if(!member?.membership_expires_at)return 'Belum aktif';const d=new Date(member.membership_expires_at);return d>new Date()?`Aktif sampai ${d.toLocaleString('id-ID',{dateStyle:'long',timeStyle:'short',timeZone:'Asia/Jakarta'})} WIB`:`Berakhir ${d.toLocaleDateString('id-ID',{timeZone:'Asia/Jakarta'})}`}
async function bootstrap(){try{checkout=await req('/checkout-capability');member=(await req('/me')).member;$('#auth').classList.add('hidden');$('#app').classList.remove('hidden');$('#logout').classList.remove('hidden');$('#member-name').textContent=member.name;$('#member-email').textContent=member.email;$('#member-access').textContent=accessText();$('#account-access').textContent=accessText();$('#profile-form [name=name]').value=member.name;$('#renewal-emails').checked=member.renewal_emails_enabled!==false;const data=await req('/catalog');courses=data.courses||[];active=Boolean(data.active);renderCheckout();renderFilters();renderCatalog();const wanted=new URLSearchParams(location.search).get('view');show(['dashboard','account','orders'].includes(wanted)?wanted:'dashboard')}catch{member=null;$('#logout').classList.add('hidden');authView(new URLSearchParams(location.search).get('view')==='register'?'register':'login')}}
async function loadDashboard(){try{const data=await req('/dashboard'),root=$('#continue-learning');root.replaceChildren();if(!data.continueLearning.length)return root.append(el('div',{class:'card empty'},'Belum ada video yang perlu dilanjutkan. Buka kelas untuk mulai belajar.'));data.continueLearning.forEach(x=>{const card=el('article',{class:'card'});card.append(el('span',{class:'pill'},x.course_title),el('h3',{},x.lesson_title),el('p',{class:'muted'},`Tersimpan di detik ${x.position}.`));const b=el('button',{class:'primary'},'Buka kelas');b.onclick=()=>{const c=courses.find(c=>String(c.id)===String(x.course_id));if(c)openCourse(c)};card.append(b);root.append(card)})}catch(e){say(e.message,true)}}
function renderFilters(){const select=$('#category'),current=select.value;while(select.options.length>1)select.remove(1);[...new Set(courses.map(c=>c.category).filter(Boolean))].sort().forEach(x=>select.add(new Option(x,x)));select.value=current}
function renderCatalog(){const root=$('#catalog'),q=$('#search').value.trim().toLowerCase(),cat=$('#category').value,fav=$('#favourite-filter').value;root.replaceChildren();const filtered=courses.filter(c=>(!cat||c.category===cat)&&(!fav||c.favourite)&&`${c.title} ${c.description||''}`.toLowerCase().includes(q)),pages=Math.max(1,Math.ceil(filtered.length/PAGE_SIZE));catalogPage=Math.min(catalogPage,pages);const list=filtered.slice((catalogPage-1)*PAGE_SIZE,catalogPage*PAGE_SIZE);$('#catalog-page').textContent=`Halaman ${catalogPage} dari ${pages}`;$('#catalog-prev').disabled=catalogPage===1;$('#catalog-next').disabled=catalogPage===pages;if(!list.length){root.append(el('div',{class:'card empty'},'Tidak ada kelas yang cocok.'));return}list.forEach(c=>{const card=el('article',{class:'card course-card'});if(c.image_url){const img=el('img',{class:'course-image',src:c.image_url,alt:''});img.addEventListener('error',()=>img.remove());card.append(img)}const body=el('div',{class:'course-body'});body.append(el('span',{class:'pill'},c.category||'Umum'),el('h3',{},c.title),el('p',{class:'muted'},c.description||'Materi kreatif dari Artstudio Nala.'));const actions=el('div',{class:'course-actions'});actions.append(el('span',{class:'muted'},`${(c.chapters||[]).reduce((n,ch)=>n+(ch.lessons||[]).length,0)} materi`));const favourite=el('button',{class:'secondary','aria-pressed':String(Boolean(c.favourite))},c.favourite?'★ Favorit':'☆ Favorit');favourite.onclick=async()=>{try{await req(`/favourites/${c.id}`,{method:'PUT',body:JSON.stringify({favourite:!c.favourite})});c.favourite=!c.favourite;renderCatalog()}catch(e){say(e.message,true)}};const open=el('button',{class:'primary'},'Buka kelas');open.onclick=()=>openCourse(c);actions.append(favourite,open);body.append(actions);card.append(body);root.append(card)})}
function openCourse(course){$('#course-category').textContent=course.category||'Umum';$('#course-title').textContent=course.title;$('#course-description').textContent=course.description||'';const list=$('#course-lessons');list.replaceChildren();let first=null;(course.chapters||[]).forEach(ch=>{list.append(el('h3',{class:'chapter'},ch.title));(ch.lessons||[]).forEach(lesson=>{const b=el('button',{class:'lesson-button'},lesson.title);b.onclick=()=>openLesson(lesson,b);list.append(b);if(!first)first=[lesson,b]})});if(!first)$('#lesson-content').replaceChildren(el('p',{class:'muted'},'Materi belum tersedia.'));else openLesson(...first);show('course')}
function openLesson(lesson,button){document.querySelectorAll('.lesson-button').forEach(x=>x.classList.remove('active'));button.classList.add('active');const root=$('#lesson-content');root.className='';root.replaceChildren(el('h2',{},lesson.title),el('p',{class:'muted'},lesson.description||''));if(lesson.youtubeVideoId&&(active||lesson.isPreview)){const frame=el('iframe',{class:'player',src:`https://www.youtube-nocookie.com/embed/${lesson.youtubeVideoId}?enablejsapi=1&origin=${encodeURIComponent(location.origin)}&start=${Math.floor(lesson.progress?.position||0)}`,title:`Video ${lesson.title}`,loading:'lazy',allowFullscreen:true});frame.dataset.lessonId=lesson.id;root.append(frame);trackPlayer(frame,lesson)}else if(!active&&!lesson.isPreview){const gate=el('div',{class:'gate'});gate.append(el('strong',{},'Keanggotaan diperlukan'),el('p',{},'Perpanjang akses untuk menonton video dan mengunduh worksheet.'));const b=el('button',{class:'primary'},'Aktifkan keanggotaan');b.onclick=buy;gate.append(b);root.append(gate)}const worksheets=lesson.worksheets||[];if(worksheets.length){root.append(el('h3',{},'Worksheet'));worksheets.forEach(w=>{const row=el('div',{class:'worksheet'});row.append(el('span',{},w.title));const b=el('button',{class:'secondary'},'Unduh PDF');b.disabled=!active;b.onclick=()=>downloadWorksheet(w);row.append(b);root.append(row)})}}
function trackPlayer(frame,lesson){playerCleanup();let last=0,timer,observer;const send=()=>frame.contentWindow?.postMessage(JSON.stringify({event:'command',func:'getCurrentTime',args:[]}), 'https://www.youtube-nocookie.com'),loaded=()=>{frame.contentWindow?.postMessage(JSON.stringify({event:'listening',id:lesson.id}),'https://www.youtube-nocookie.com');timer=setInterval(send,15000)};frame.addEventListener('load',loaded);const handler=e=>{if(e.source!==frame.contentWindow||e.origin!=='https://www.youtube-nocookie.com')return;let x;try{x=JSON.parse(e.data)}catch{return}if(x.event==='infoDelivery'&&Number.isFinite(x.info?.currentTime)&&Number.isFinite(x.info?.duration)&&Date.now()-last>14000){last=Date.now();say('Menyimpan progres…');req(`/progress/${lesson.id}`,{method:'PUT',body:JSON.stringify({position:Math.floor(x.info.currentTime),duration:Math.floor(x.info.duration),completed:x.info.duration>0&&x.info.currentTime/x.info.duration>=.95})}).then(()=>say('Progres tersimpan.')).catch(e=>say(`Progres gagal disimpan: ${e.message}`,true))}};addEventListener('message',handler);playerCleanup=()=>{clearInterval(timer);frame.removeEventListener('load',loaded);removeEventListener('message',handler);observer?.disconnect();playerCleanup=()=>{}};observer=new MutationObserver(()=>{if(!frame.isConnected)playerCleanup()});observer.observe(document.body,{childList:true,subtree:true})}
async function downloadWorksheet(w){try{say('Menyiapkan worksheet…');const r=await fetch(`${API}/api/member/worksheets/${w.id}`,{credentials:'include'});if(!r.ok){const x=await r.json().catch(()=>({}));throw Error(x.message||'Worksheet gagal diunduh.')}const url=URL.createObjectURL(await r.blob()),a=el('a',{href:url,download:`${w.title||'worksheet'}.pdf`});a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);say('Worksheet berhasil diunduh.')}catch(e){say(e.message,true)}}
async function loadSessions(){try{const data=await req('/sessions'),root=$('#sessions');root.replaceChildren();data.sessions.forEach(s=>{const row=el('div',{class:'worksheet'});row.append(el('span',{},`${s.current?'Sesi ini':'Sesi lain'} · berakhir ${new Date(s.expires_at).toLocaleString('id-ID')}`));if(!s.current){const b=el('button',{class:'secondary'},'Cabut');b.onclick=async()=>{try{await req(`/sessions/${s.id}`,{method:'DELETE',body:'{}'});await loadSessions()}catch(e){say(e.message,true)}};row.append(b)}root.append(row)})}catch(e){say(e.message,true)}}
async function loadOrders(){try{orders=(await req('/orders')).orders||[];renderOrders();startPolling()}catch(e){say(e.message,true)}}
function renderOrders(){const root=$('#orders');root.replaceChildren();if(!orders.length){root.append(el('div',{class:'card empty'},'Belum ada pesanan.'));return}orders.forEach(o=>{const row=el('article',{class:'order card'}),head=el('div',{class:'order-head'});head.append(el('strong',{},o.order_id),el('span',{class:`status ${o.status}`},o.status));row.append(head,el('span',{},`Rp${Number(o.amount).toLocaleString('id-ID')} · ${o.duration_days} hari`),el('span',{class:'muted'},new Date(o.created_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'})));if(o.status==='pending'&&o.provider_redirect_url)row.append(el('a',{class:'button',href:o.provider_redirect_url,target:'_blank',rel:'noopener'},'Lanjutkan pembayaran'));root.append(row)})}
function startPolling(){clearTimeout(pollTimer);if($('#orders-view').classList.contains('hidden')||!orders.some(o=>o.status==='pending')||pollCount>=10)return;pollTimer=setTimeout(async()=>{pollCount++;await loadOrders()},6000)}
function renderCheckout(){const plan=checkout.plans?.[0],available=Boolean(checkout.enabled&&plan),label=!member?.membership_expires_at?'Aktifkan membership':active?'Perpanjang membership':'Beli membership',detail=plan?` — ${plan.durationDays} hari · Rp${Number(plan.price).toLocaleString('id-ID')}`:'';[$('#renew'),...document.querySelectorAll('[data-buy]')].forEach(b=>{b.disabled=!available;b.textContent=available?label+detail:'Pembayaran member belum tersedia'});if(!available)say('Pembayaran member belum tersedia.',true)}
async function buy(){const plan=checkout.plans?.[0];if(!checkout.enabled||!plan)return say('Pembayaran member belum tersedia.',true);try{say('Membuat pesanan…');const x=await req('/orders',{method:'POST',body:JSON.stringify({planId:plan.id})});say('Pesanan dibuat. Buka pembayaran di tab baru.');window.open(x.redirectUrl,'_blank','noopener');pollCount=0;show('orders')}catch(e){say(e.message,true)}}
async function program(name){const root=$('#program-content');root.replaceChildren(el('p',{},'Memuat…'));try{if(name==='access'){const x=await req('/program/plans');root.replaceChildren(el('h2',{},'Paket & voucher'));x.plans.forEach(p=>{const row=el('div',{class:'worksheet'});row.append(el('span',{},`${p.name} · ${p.durationDays} hari · Rp${Number(p.price).toLocaleString('id-ID')}`));const b=el('button',{class:'primary',disabled:!checkout.enabled},checkout.enabled?'Beli QRIS':'Pembayaran belum tersedia');b.onclick=()=>buyPlan(p.id,b);row.append(b);root.append(row)});const f=el('form',{class:'form-actions'});const input=el('input',{name:'code',required:true,placeholder:'Kode voucher'}),b=el('button',{class:'primary'},'Pakai voucher');f.append(input,b);f.onsubmit=async e=>{e.preventDefault();b.disabled=true;try{const x=await req('/program/vouchers/redeem',{method:'POST',body:JSON.stringify({code:input.value})});member.membership_expires_at=x.membershipExpiresAt;active=true;say('Voucher berhasil dipakai.')}catch(x){say(x.message,true)}finally{b.disabled=false}};root.append(f)}else if(name==='qa'){const x=await req('/program/questions');root.replaceChildren(el('h2',{},'Tanya jawab privat'));if(!x.enabled)root.append(el('p',{class:'muted'},'Fitur ini sedang dinonaktifkan oleh pemilik. Pertanyaan lama tetap dapat dibaca.'));x.questions.forEach(q=>root.append(el('article',{class:'worksheet'},`${q.question} — ${q.answer||q.status}`)));if(x.enabled){const f=el('form',{class:'field'}),sel=el('select',{name:'courseId'}),ta=el('textarea',{name:'question',required:true,maxLength:1000}),b=el('button',{class:'primary'},'Kirim pertanyaan');courses.forEach(c=>sel.add(new Option(c.title,c.id)));f.append(sel,ta,b);f.onsubmit=async e=>{e.preventDefault();const d=new FormData(f);b.disabled=true;try{await req('/program/questions',{method:'POST',body:JSON.stringify(Object.fromEntries(d))});program('qa')}catch(x){say(x.message,true)}finally{b.disabled=false}};root.append(f)}}else if(name==='challenges'){const x=await req('/program/challenges');root.replaceChildren(el('h2',{},'Tantangan'));if(!x.enabled)root.append(el('p',{},'Tantangan sedang dinonaktifkan oleh pemilik.'));x.challenges.forEach(c=>root.append(el('article',{class:'worksheet'},`${c.title} · ${new Date(c.opensAt).toLocaleDateString('id-ID')}–${new Date(c.closesAt).toLocaleDateString('id-ID')}: ${c.prompt}`)))}else if(name==='certs'){const x=await req('/program/certificates');root.replaceChildren(el('h2',{},'Sertifikat'));if(!x.enabled)root.append(el('p',{},'Sertifikat sedang dinonaktifkan oleh pemilik.'));x.certificates.forEach(c=>{const row=el('article',{class:'worksheet'});row.append(el('span',{},`${c.title} · ${c.eligible?'layak diterbitkan':'belum memenuhi syarat'}`));if(c.certificateId){const b=el('button',{class:'primary'},'Cetak');b.onclick=()=>printCertificate(c);row.append(b)}else if(c.eligible){const b=el('button',{class:'primary'},'Terbitkan');b.onclick=async()=>{const displayName=prompt('Nama pada sertifikat',member.name);if(displayName){await req(`/program/certificates/${c.courseId}`,{method:'POST',body:JSON.stringify({displayName})});program('certs')}};row.append(b)}root.append(row)})}else{const [x,h]=await Promise.all([req('/program/artworks'),req('/program/challenges')]);root.replaceChildren(el('h2',{},'Karya privat'));if(!x.enabled)root.append(el('p',{},'Unggah karya sedang dinonaktifkan oleh pemilik.'));x.artworks.forEach(a=>root.append(artworkCard(a)));if(x.enabled)root.append(artForm(h.challenges||[]))}}catch(e){root.replaceChildren(el('p',{class:'error'},e.message))}}
async function buyPlan(planId,b){b.disabled=true;try{const x=await req('/orders',{method:'POST',body:JSON.stringify({planId})});window.open(x.redirectUrl,'_blank','noopener');show('orders')}catch(e){say(e.message,true)}finally{b.disabled=false}}
function artForm(challenges=[]){const f=el('form',{class:'field'}),file=el('input',{type:'file',accept:'image/jpeg,image/png,image/webp',required:true}),title=el('input',{placeholder:'Judul karya',maxLength:100}),target=el('select',{}),b=el('button',{class:'primary'},'Unggah maksimal 8 MB');courses.forEach(c=>target.add(new Option(`Kelas · ${c.title}`,`course:${c.id}`)));challenges.forEach(c=>target.add(new Option(`Tantangan · ${c.title}`,`challenge:${c.id}`)));f.append(title,target,file,b);f.onsubmit=async e=>{e.preventDefault();if(b.disabled)return;const x=file.files[0];if(!x||x.size>8*1024*1024)return say('Pilih JPG, PNG, atau WebP maksimal 8 MB.',true);b.disabled=true;try{const base64=await new Promise((ok,no)=>{const r=new FileReader;r.onload=()=>ok(String(r.result).split(',')[1]);r.onerror=no;r.readAsDataURL(x)}),[kind,id]=target.value.split(':');await req('/program/artworks',{method:'POST',body:JSON.stringify({[kind==='challenge'?'challengeId':'courseId']:id,title:title.value||'Karya Member Nala',base64})});program('art')}catch(x){say(x.message,true)}finally{b.disabled=false}};return f}
function artworkCard(a){const card=el('article',{class:'card'}),img=el('img',{class:'course-image',src:`${API}/api/member/program/artworks/${a.id}/image`,alt:`Karya ${a.title}`}),status=el('p',{class:'muted'},`Status galeri: ${a.galleryStatus||'belum diajukan'}`),del=el('button',{class:'danger'},'Hapus karya');del.onclick=async()=>{if(!confirm('Hapus karya privat permanen?'))return;del.disabled=true;try{await req(`/program/artworks/${a.id}`,{method:'DELETE'});program('art')}catch(e){say(e.message,true)}finally{del.disabled=false}};card.append(img,el('h3',{},a.title),status);if(a.galleryStatus&&!['revoked','rejected'].includes(a.galleryStatus)){const revoke=el('button',{class:'secondary'},'Cabut izin galeri');revoke.onclick=async()=>{revoke.disabled=true;try{await req(`/program/artworks/${a.id}/gallery`,{method:'DELETE'});status.textContent='Status galeri: revoked';say('Izin dicabut segera.')}catch(e){say(e.message,true)}finally{revoke.disabled=false}};card.append(revoke)}else{const form=el('form',{class:'field'}),caption=el('input',{placeholder:'Caption umum tanpa kontak atau URL',maxLength:100,required:true}),label=el('label',{}),consent=el('input',{type:'checkbox',required:true}),submit=el('button',{class:'primary'},'Ajukan ke galeri');label.append(consent,document.createTextNode(' Saya setuju karya dan caption ini ditampilkan publik. Nama, email, dan data akun tidak ditampilkan. Izin dapat dicabut kapan saja.'));form.append(caption,label,submit);form.onsubmit=async e=>{e.preventDefault();if(submit.disabled)return;submit.disabled=true;try{await req(`/program/artworks/${a.id}/gallery`,{method:'POST',body:JSON.stringify({caption:caption.value,consent:consent.checked})});program('art')}catch(e){say(e.message,true)}finally{submit.disabled=false}};card.append(form)}card.append(del);return card}
function printCertificate(c){const w=open('','_blank');if(!w)return;const title=document.createElement('h1'),name=document.createElement('h2'),course=document.createElement('p');title.textContent='Sertifikat Penyelesaian';name.textContent=c.displayName;course.textContent=c.courseTitle;w.document.body.append(title,name,course);w.document.title='Sertifikat Nala';w.print()}
$('#login-form').onsubmit=async e=>{e.preventDefault();try{say('Memeriksa akun…');await req('/login',{method:'POST',body:JSON.stringify(Object.fromEntries(new FormData(e.currentTarget)))});say('Berhasil masuk.');await bootstrap()}catch(err){say(err.message,true)}};
$('#register-form').onsubmit=async e=>{e.preventDefault();const form=new FormData(e.currentTarget),payload=Object.fromEntries(form),email=String(form.get('email')||'');try{const data=await req('/register',{method:'POST',body:JSON.stringify(payload)});say(data.message);$('#resend-form [name=email]').value=email;authView('resend')}catch(err){say(err.message,true)}};
$('#resend-form').onsubmit=async e=>{e.preventDefault();try{const data=await req('/resend-verification',{method:'POST',body:JSON.stringify(Object.fromEntries(new FormData(e.currentTarget)))});say(data.message)}catch(err){say(err.message,true)}};
$('#profile-form').onsubmit=async e=>{e.preventDefault();try{const name=new FormData(e.currentTarget).get('name');await req('/profile',{method:'PUT',body:JSON.stringify({name})});member.name=String(name);$('#member-name').textContent=member.name;say('Nama berhasil diperbarui.')}catch(err){say(err.message,true)}};
$('#preferences-form').onsubmit=async e=>{e.preventDefault();try{const renewalEmails=$('#renewal-emails').checked;await req('/preferences',{method:'PUT',body:JSON.stringify({renewalEmails})});member.renewal_emails_enabled=renewalEmails;say('Preferensi email disimpan.')}catch(err){say(err.message,true)}};
$('#forgot').onclick=async()=>{const email=$('#login-form [name=email]').value;if(!email)return say('Isi email terlebih dahulu.',true);try{const x=await req('/forgot-password',{method:'POST',body:JSON.stringify({email})});say(x.message)}catch(e){say(e.message,true)}};
document.querySelectorAll('[data-auth]').forEach(b=>b.onclick=()=>authView(b.dataset.auth));document.querySelectorAll('#nav [data-view]').forEach(b=>b.onclick=()=>show(b.dataset.view));document.querySelectorAll('[data-program]').forEach(b=>b.onclick=()=>program(b.dataset.program));document.querySelectorAll('[data-buy]').forEach(b=>b.onclick=buy);$('#renew').onclick=buy;$('#logout').onclick=async()=>{try{await req('/logout',{method:'POST',body:'{}'})}finally{location.href='/portal?view=login'}};$('#search').oninput=()=>{catalogPage=1;renderCatalog()};$('#category').onchange=()=>{catalogPage=1;renderCatalog()};$('#favourite-filter').onchange=()=>{catalogPage=1;renderCatalog()};$('#catalog-prev').onclick=()=>{catalogPage--;renderCatalog()};$('#catalog-next').onclick=()=>{catalogPage++;renderCatalog()};$('#refresh-sessions').onclick=loadSessions;$('#back-catalog').onclick=()=>show('catalog');$('#refresh-orders').onclick=()=>{pollCount=0;loadOrders()};bootstrap();
</script></body></html>