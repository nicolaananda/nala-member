---
import '../styles.css';
const api=import.meta.env.PUBLIC_API_URL||'https://api.artstudionala.com';
---
<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Reset password · Artstudio Nala</title></head><body data-api={api}><header class="site-header"><div class="wrap header-inner"><a class="brand" href="/"><img src="/nala-logo.png" alt="Artstudio Nala"></a></div></header><main class="wrap auth-shell"><form class="card"><span class="eyebrow">Keamanan akun</span><h1>Buat password baru</h1><p class="muted">Gunakan minimal 10 karakter yang tidak mudah ditebak.</p><label class="field">Password baru<input name="password" type="password" minlength="10" maxlength="200" required autocomplete="new-password"></label><label class="field">Ulangi password<input name="confirmation" type="password" minlength="10" maxlength="200" required autocomplete="new-password"></label><button class="primary">Perbarui password</button><p id="status" class="message" role="status" aria-live="polite"></p><a href="/portal?view=login">Kembali ke halaman masuk</a></form></main><script>const f=document.querySelector('form'),s=document.querySelector('#status');f.onsubmit=async e=>{e.preventDefault();const data=new FormData(f),password=data.get('password');if(password!==data.get('confirmation')){s.textContent='Konfirmasi password belum sama.';s.className='message error';return}s.textContent='Memproses…';s.className='message';try{const r=await fetch(document.body.dataset.api+'/api/member/reset-password',{method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({token:new URLSearchParams(location.search).get('token')||'',password})}),x=await r.json();s.textContent=x.message||'Permintaan gagal.';s.className=`message ${r.ok?'success':'error'}`;if(r.ok){f.querySelectorAll('input,button').forEach(x=>x.disabled=true);setTimeout(()=>location.href='/portal?view=login',1500)}}catch{s.textContent='Server tidak dapat dihubungi. Coba lagi.';s.className='message error'}}</script></body></html>