---
import '../../../styles.css';
const api=import.meta.env.PUBLIC_API_URL||'https://api.artstudionala.com';
---
<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="robots" content="noindex,nofollow"><title>Editor kursus · Nala</title></head><body class="admin-shell editor-shell" data-api={api} data-editor="course"><header class="site-header"><div class="wrap header-inner"><a class="brand" href="/admin/"><img src="/nala-logo.png" alt="Artstudio Nala"></a><nav class="nav"><a class="button" href="/admin/?view=courses">← Kursus</a><button id="logout">Keluar</button></nav></div></header><main class="wrap member-layout"><p id="notice" class="message" role="status"></p><p id="state" class="card">Memuat editor…</p><section id="editor" class="hidden"><nav class="breadcrumbs"><a href="/admin/?view=courses">Admin</a><span>›</span><span>Kursus</span></nav><form id="editor-form" class="card editor-form"><span class="eyebrow">Kursus</span><h1 id="editor-title"></h1><label class="field">Judul<input name="title" maxlength="200" required></label><div class="form-grid"><label class="field">Slug<input name="slug" pattern="[a-z0-9-]{2,100}" required></label><label class="field">Kategori<input name="category" maxlength="100"></label></div><label class="field">Thumbnail HTTPS<input name="imageUrl" type="url"></label><label class="field">Deskripsi<textarea name="description" maxlength="5000"></textarea></label><div class="form-grid"><label class="field">Urutan<input name="sortOrder" type="number" min="0" required></label><label class="field">Status<select name="status"><option value="draft">Draft</option><option value="published">Terbit</option><option value="archived">Arsip</option></select></label></div><div class="form-actions"><a class="button" href="/admin/?view=courses">Batal</a><button class="primary">Simpan kursus</button></div></form><section id="lesson-links" class="editor-related"></section></section></main><script is:inline src="/admin-editor.js"></script></body></html>