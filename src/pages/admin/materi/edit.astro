---
import '../../../styles.css';
const api=import.meta.env.PUBLIC_API_URL||'https://api.artstudionala.com';
---
<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="robots" content="noindex,nofollow"><title>Editor materi · Nala</title></head><body class="admin-shell editor-shell" data-api={api} data-editor="lesson"><header class="site-header"><div class="wrap header-inner"><a class="brand" href="/admin/"><img src="/nala-logo.png" alt="Artstudio Nala"></a><nav class="nav"><a class="button" href="/admin/">Admin</a><button id="logout">Keluar</button></nav></div></header><main class="wrap member-layout"><p id="notice" class="message" role="status"></p><p id="state" class="card">Memuat editor…</p><section id="editor" class="hidden"><nav class="breadcrumbs"><a href="/admin/">Admin</a><span>›</span><a id="course-link" href="/admin/">Kursus</a><span>›</span><span>Materi</span></nav><form id="editor-form" class="card editor-form"><span class="eyebrow">Materi · <span id="chapter-name"></span></span><h1 id="editor-title"></h1><label class="field">Judul<input name="title" maxlength="200" required></label><label class="field">YouTube URL atau ID<input name="youtube"></label><label class="field">Deskripsi<textarea name="description" maxlength="5000"></textarea></label><div class="form-grid"><label class="field">Urutan<input name="sortOrder" type="number" min="0" required></label><label class="check"><input name="isPreview" type="checkbox"> Pratinjau publik</label></div><div id="worksheets" class="worksheet-links"></div><label id="worksheet-field" class="field hidden">Unggah worksheet PDF ≤ 10 MB<input id="worksheet-file" type="file" accept="application/pdf,.pdf"></label><div class="form-actions"><a id="back-course" class="button" href="/admin/?view=courses">Kembali</a><button id="delete-lesson" type="button" class="danger hidden">Hapus materi</button><button class="primary">Simpan materi</button></div></form></section></main><script is:inline src="/admin-editor.js"></script></body></html>