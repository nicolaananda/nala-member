---
const API = import.meta.env.PUBLIC_API_URL || 'https://api.artstudionala.com';
---
<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Operasional & Analitik · Nala</title><link rel="stylesheet" href="/src/styles.css"></head><body>
<header class="site-header"><div class="wrap header-inner"><a class="brand" href="/admin"><img src="/nala-logo.png" alt="Artstudio Nala"><span><strong>Operasional & Analitik</strong><small>Member Nala</small></span></a><nav class="nav"><a href="/admin">Kembali ke admin</a></nav></div></header>
<main class="wrap member-layout"><p id="notice" class="message" role="status" aria-live="polite"></p>
<section id="ops"><div class="section-head"><div><span class="eyebrow">C1</span><h1>Kesehatan operasional</h1><p class="muted">Data PostgreSQL dan audit internal. Tidak memakai layanan monitoring eksternal.</p></div><button id="refresh" class="secondary">Muat ulang</button></div><div id="health" class="summary"></div><div class="form-grid"><section class="card"><h2>Notifikasi</h2><div id="notifications"></div></section><section class="card"><h2>Backup</h2><div id="backup"></div></section></div><section class="card"><h2>Audit terbaru</h2><div id="audit" class="ops-list"></div></section><section class="card"><h2>Error & event</h2><div id="events" class="ops-list"></div></section></section>
<section><div class="section-head"><div><span class="eyebrow">C2</span><h1>Analitik pembelajaran</h1><p class="muted">Waktu adalah perkiraan dari posisi materi terakhir, bukan absensi.</p></div><a id="csv" class="button" href="#">Ekspor CSV</a></div><label class="field">Rentang aktivitas<select id="days"><option value="7">7 hari</option><option value="30" selected>30 hari</option><option value="90">90 hari</option></select></label><div id="analytics-summary" class="summary"></div><section class="card"><h2>Learner & inaktivitas</h2><div id="learners" class="ops-list"></div></section><section class="card"><h2>Penyelesaian kursus/materi</h2><div id="courses" class="ops-list"></div></section><section class="card"><h2>Quiz & pertanyaan sulit</h2><div id="quizzes" class="ops-list"></div></section></section>
<section><div class="section-head"><div><span class="eyebrow">C3–C4</span><h1>Komunikasi & penilaian</h1></div><button id="process-queue" class="secondary">Proses antrean</button></div><div class="form-grid"><section class="card"><h2>Template pesan</h2><form id="template-form"><label class="field">Kunci<input name="key" pattern="[a-z0-9_-]{2,50}" required></label><label class="field">Judul<input name="title" maxlength="200" required></label><label class="field">Isi<textarea name="body" maxlength="2000" required></textarea></label><label><input name="email" type="checkbox"> Email (provider nonaktif)</label><button>Simpan</button></form><div id="templates"></div></section><section class="card"><h2>Antrean & status</h2><div id="queue"></div></section></div><div class="form-grid"><section class="card"><h2>Bank soal</h2><div id="bank"></div></section><section class="card"><h2>Rubrik reusable</h2><div id="rubrics"></div></section></div><section class="card"><h2>Gradebook per kelas</h2><form id="gradebook-form"><label class="field">ID kelas<input name="course" inputmode="numeric" pattern="[1-9][0-9]*" required></label><button>Tampilkan</button><a id="gradebook-csv" class="button" hidden>CSV</a></form><div id="gradebook"></div></section></section></main>
<script define:vars={{API}}>
const $=s=>document.querySelector(s),n=(tag,text,cls='')=>Object.assign(document.createElement(tag),{textContent:text,className:cls}),fmt=v=>v?new Date(v).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}):'—';
async function get(path){const r=await fetch(API+path,{credentials:'include'}),x=await r.json().catch(()=>({}));if(!r.ok)throw Object.assign(Error(x.message||'Permintaan gagal'),{status:r.status});return x}
const rows=(root,data,render,empty='Belum ada data.')=>{root.replaceChildren();if(!data.length)return root.append(n('p',empty,'muted'));data.forEach(x=>root.append(n('p',render(x),'history-row')))};
async function loadOps(){try{const [x,e]=await Promise.all([get('/api/admin/member-c/operations'),get('/api/admin/member-c/operations/events')]);$('#ops').hidden=false;$('#health').replaceChildren(n('strong',`Status: ${x.health.status}`),n('span',`Database: ${x.health.database} · ${(Number(x.health.databaseBytes)/1048576).toFixed(1)} MB`),n('span',`Alert terbuka: ${x.alerts.open} · error: ${x.alerts.errors}${x.alerts.backupStale?' · backup perlu perhatian':''}`));rows($('#notifications'),x.notifications,z=>`${z.email_status}: ${z.count} · terakhir ${fmt(z.last_at)}`);$('#backup').replaceChildren(n('p',x.backup?`${x.backup.status} · terakhir sukses ${fmt(x.backup.last_success_at)} · retensi ${x.backup.retention_days} hari · ${x.backup.location}`:'Metadata belum ada'));rows($('#audit'),x.audit,z=>`${fmt(z.created_at)} · ${z.admin_email} · ${z.action} · ${z.entity_type}${z.entity_id?' #'+z.entity_id:''}`);rows($('#events'),e.events,z=>`${fmt(z.occurred_at)} · ${z.severity} · ${z.kind} · ${z.message}${z.resolved_at?' · selesai':''}`)}catch(e){if(e.status===403)$('#ops').hidden=true;else throw e}}
async function loadAnalytics(){const d=$('#days').value,x=await get(`/api/admin/member-c/analytics?days=${d}`);$('#csv').href=`${API}/api/admin/member-c/analytics?days=${d}&format=csv`;$('#analytics-summary').replaceChildren(n('strong',`${x.summary.active_learners} learner aktif`),n('span',`${x.summary.completed_materials} materi selesai`),n('span',`${Math.round(Number(x.summary.approximate_seconds)/60)} menit perkiraan`));rows($('#learners'),x.learners,z=>`${z.name||z.email} · terakhir ${fmt(z.last_activity_at)} · ${z.completed_materials} selesai · ${Math.round(Number(z.approximate_seconds)/60)} menit${z.inactive?' · tidak aktif 14+ hari':''}`);rows($('#courses'),x.courses,z=>`${z.title} · ${z.completed_materials}/${z.materials} materi memiliki penyelesaian · ${z.learners} learner`);rows($('#quizzes'),[...x.quizzes.map(z=>`${z.title} · ${z.attempts} percobaan · rata-rata ${z.average_score??'—'} · lulus ${z.passed}`),...x.difficultQuestions.map(z=>`Sulit: ${z.course_title} · ${z.prompt} · salah ${z.incorrect}/${z.answers}`)],z=>z)}
async function loadC34(){const [t,q,b,r]=await Promise.all([get('/api/admin/member-c/templates'),get('/api/admin/member-c/queue'),get('/api/admin/member-c/question-bank'),get('/api/admin/member-c/rubrics')]);rows($('#templates'),t.templates,x=>`${x.key} · ${x.title} · ${x.channels.join(', ')}`);rows($('#queue'),q.deliveries,x=>`${fmt(x.scheduled_at)} · ${x.email} · ${x.channel} · ${x.status}${x.last_error?' · '+x.last_error:''}`);rows($('#bank'),b.questions,x=>`${x.course_title} · ${x.prompt}`);rows($('#rubrics'),r.rubrics,x=>`${x.title} · ${x.criteria.length} kriteria`)}
async function load(){try{$('#notice').textContent='';await Promise.all([loadOps(),loadAnalytics(),loadC34()])}catch(e){if(e.status===401)location.href='/admin';else if(e.status!==403)$('#notice').textContent=e.message}}
async function send(path,body={}){const r=await fetch(API+path,{method:'POST',credentials:'include',headers:{'content-type':'application/json'},body:JSON.stringify(body)}),x=await r.json().catch(()=>({}));if(!r.ok)throw Error(x.message||'Permintaan gagal');return x}
$('#template-form').onsubmit=async e=>{e.preventDefault();const f=new FormData(e.currentTarget);await send('/api/admin/member-c/templates',{key:f.get('key'),title:f.get('title'),body:f.get('body'),channels:['in_app',...(f.get('email')?['email']:[])]});e.currentTarget.reset();loadC34()};
$('#process-queue').onclick=async()=>{await send('/api/admin/member-c/queue/process');loadC34()};
$('#gradebook-form').onsubmit=async e=>{e.preventDefault();const course=new FormData(e.currentTarget).get('course'),x=await get(`/api/admin/member-c/gradebook/${course}`);rows($('#gradebook'),x.students,z=>`${z.name} · quiz ${z.quiz_average??'—'} · karya ${z.artwork_average??'—'}`);$('#gradebook-csv').hidden=false;$('#gradebook-csv').href=`${API}/api/admin/member-c/gradebook/${course}?format=csv`};
$('#refresh').onclick=load;$('#days').onchange=loadAnalytics;load();
</script></body></html>
