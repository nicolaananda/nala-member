---
import '../../styles.css';
const API = import.meta.env.PUBLIC_API_URL || 'https://api.artstudionala.com';
---
<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Operasional & Analitik · Nala</title><meta name="robots" content="noindex,nofollow"></head><body class="admin-shell ops-dashboard" data-api={API}>
<header class="site-header"><div class="wrap header-inner"><a class="brand" href="/admin" aria-label="Admin Nala"><img src="/nala-logo.png" alt=""><span><strong>Nala Studio</strong><small>Operasional</small></span></a><details class="admin-menu"><summary aria-label="Buka menu navigasi"><span>Menu</span><b aria-hidden="true">☰</b></summary><nav class="nav" aria-label="Navigasi operasional"><span class="nav-label">Pantau</span><a href="#health-panel">Kesehatan</a><a href="#analytics-panel">Analitik</a><a href="#integration-panel">Integrasi C1–C6</a><a href="/admin">← Admin utama</a></nav></details></div></header>
<main class="wrap member-layout"><p id="notice" class="message" role="status" aria-live="polite"></p>
<header class="ops-hero"><div><span class="eyebrow">Pusat kendali</span><h1>Operasional & analitik</h1><p class="muted">Pantau kesehatan sistem, aktivitas belajar, dan pekerjaan integrasi.</p></div><button id="refresh" class="secondary">Muat ulang data</button></header>
<section id="health-panel" class="ops-section"><div class="section-head"><div><span class="eyebrow">Kesehatan sistem</span><h2>Kondisi layanan</h2></div><span id="updated" class="muted" aria-live="polite"></span></div><div id="health" class="ops-kpis" aria-busy="true"><p class="card empty">Memuat kesehatan sistem…</p></div><div class="ops-columns"><section class="card"><div class="card-heading"><h3>Notifikasi</h3><span class="status-dot">Pengiriman</span></div><div id="notifications"><p class="muted">Memuat…</p></div></section><section class="card"><div class="card-heading"><h3>Backup</h3><span class="status-dot">Proteksi data</span></div><div id="backup"><p class="muted">Memuat…</p></div></section></div><details class="card disclosure" open><summary><span><strong>Alert & event</strong><small>Error dan event operasional terbaru</small></span></summary><div id="events" class="data-list"></div></details><details class="card disclosure"><summary><span><strong>Audit terbaru</strong><small>Aktivitas administrator</small></span></summary><div id="audit" class="data-list"></div></details></section>
<section id="analytics-panel" class="ops-section"><div class="section-head"><div><span class="eyebrow">Pembelajaran</span><h2>Analitik aktivitas</h2><p class="muted">Durasi adalah perkiraan posisi materi terakhir, bukan absensi.</p></div><div class="inline-actions"><label class="compact-field">Rentang<select id="days"><option value="7">7 hari</option><option value="30" selected>30 hari</option><option value="90">90 hari</option></select></label><a id="csv" class="button" href="#">Ekspor CSV</a></div></div><div id="analytics-summary" class="ops-kpis"><p class="card empty">Memuat analitik…</p></div><div class="ops-columns"><details class="card disclosure" open><summary><span><strong>Learner & inaktivitas</strong><small>Aktivitas per murid</small></span></summary><div id="learners" class="data-list"></div></details><details class="card disclosure"><summary><span><strong>Penyelesaian kursus</strong><small>Progres berdasarkan materi</small></span></summary><div id="courses" class="data-list"></div></details></div><details class="card disclosure"><summary><span><strong>Quiz & pertanyaan sulit</strong><small>Hasil dan area yang perlu ditinjau</small></span></summary><div id="quizzes" class="data-list"></div></details></section>
<section id="integration-panel" class="ops-section"><div class="section-head"><div><span class="eyebrow">Integrasi</span><h2>Komunikasi, akademik & administrasi</h2></div><button id="process-queue" class="secondary">Proses antrean</button></div><div class="ops-tabs" role="tablist" aria-label="Kelompok integrasi"><button role="tab" aria-selected="true" data-tab="communication">Komunikasi</button><button role="tab" aria-selected="false" data-tab="academic">Akademik</button><button role="tab" aria-selected="false" data-tab="administration">Administrasi</button></div>
<div data-panel="communication" class="tab-panel"><div class="ops-columns"><details class="card disclosure" open><summary><span><strong>Template pesan</strong><small>Buat pesan dalam aplikasi</small></span></summary><form id="template-form" class="compact-form"><label class="field">Kunci<input name="key" pattern="[a-z0-9_-]{2,50}" required></label><label class="field">Judul<input name="title" maxlength="200" required></label><label class="field">Isi<textarea name="body" maxlength="2000" required></textarea></label><label class="check"><input name="email" type="checkbox" disabled> Email <small>Belum tersedia karena provider email nonaktif.</small></label><button class="primary">Simpan template</button></form><div id="templates" class="data-list"></div></details><section class="card"><div class="card-heading"><h3>Antrean pengiriman</h3><span class="status-dot">Status</span></div><div id="queue" class="data-list"></div></section></div></div>
<div data-panel="academic" class="tab-panel hidden"><div class="ops-columns"><details class="card disclosure" open><summary><span><strong>Bank soal</strong><small>Soal yang tersedia per kursus</small></span></summary><div id="bank" class="data-list"></div></details><details class="card disclosure" open><summary><span><strong>Rubrik reusable</strong><small>Kriteria penilaian tersimpan</small></span></summary><div id="rubrics" class="data-list"></div></details></div></div>
<div data-panel="administration" class="tab-panel hidden"><section class="card"><div class="card-heading"><div><h3>Gradebook per kelas</h3><p class="muted">Masukkan ID kelas untuk memuat hasil murid.</p></div></div><form id="gradebook-form" class="inline-form"><label class="field">ID kelas<input name="course" inputmode="numeric" pattern="[1-9][0-9]*" required></label><button class="primary">Tampilkan</button><a id="gradebook-csv" class="button" hidden>Ekspor CSV</a></form><div id="gradebook" class="data-list"></div></section></div></section></main>
<script>
const API=document.body.dataset.api,$=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)],n=(tag,text,cls='')=>Object.assign(document.createElement(tag),{textContent:text,className:cls}),fmt=v=>v?new Date(v).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}):'—';
async function get(path){const r=await fetch(API+path,{credentials:'include'}),x=await r.json().catch(()=>({}));if(!r.ok)throw Object.assign(Error(x.message||'Permintaan gagal'),{status:r.status});return x}
const rows=(root,data,render,empty='Belum ada data.')=>{root.replaceChildren();if(!data.length)return root.append(n('p',empty,'empty-state'));data.forEach(x=>root.append(n('p',render(x),'data-row')))};
const kpis=(root,items)=>root.replaceChildren(...items.map(([label,value,tone=''])=>{const card=n('article','','kpi-card '+tone);card.append(n('span',label),n('strong',value));return card}));
async function loadOps(){try{const [x,e]=await Promise.all([get('/api/admin/member-c/operations'),get('/api/admin/member-c/operations/events')]);$('#health-panel').hidden=false;kpis($('#health'),[['Sistem',x.health.status,x.health.status==='ok'?'good':'warn'],['Database',x.health.database],['Ukuran data',`${(Number(x.health.databaseBytes)/1048576).toFixed(1)} MB`],['Alert terbuka',String(x.alerts.open),x.alerts.open?'warn':'good'],['Error',String(x.alerts.errors),x.alerts.errors?'bad':'good']]);rows($('#notifications'),x.notifications,z=>`${z.email_status}: ${z.count} · terakhir ${fmt(z.last_at)}`);$('#backup').replaceChildren(n('p',x.backup?`${x.backup.status} · terakhir sukses ${fmt(x.backup.last_success_at)}`:'Metadata belum ada','data-row'),x.backup?n('small',`Retensi ${x.backup.retention_days} hari · ${x.backup.location}`,'muted'):n('span',''));rows($('#audit'),x.audit,z=>`${fmt(z.created_at)} · ${z.admin_email} · ${z.action} · ${z.entity_type}${z.entity_id?' #'+z.entity_id:''}`);rows($('#events'),e.events,z=>`${z.severity.toUpperCase()} · ${fmt(z.occurred_at)} · ${z.kind} · ${z.message}${z.resolved_at?' · selesai':''}`,'Tidak ada event.');$('#updated').textContent=`Diperbarui ${fmt(new Date())}`}catch(e){if(e.status===403)$('#health-panel').hidden=true;else throw e}}
async function loadAnalytics(){const d=$('#days').value,x=await get(`/api/admin/member-c/analytics?days=${d}`);$('#csv').href=`${API}/api/admin/member-c/analytics?days=${d}&format=csv`;kpis($('#analytics-summary'),[['Learner aktif',x.summary.active_learners],['Materi selesai',x.summary.completed_materials],['Perkiraan belajar',`${Math.round(Number(x.summary.approximate_seconds)/60)} menit`]]);rows($('#learners'),x.learners,z=>`${z.name||z.email} · terakhir ${fmt(z.last_activity_at)} · ${z.completed_materials} selesai · ${Math.round(Number(z.approximate_seconds)/60)} menit${z.inactive?' · tidak aktif 14+ hari':''}`);rows($('#courses'),x.courses,z=>`${z.title} · ${z.completed_materials}/${z.materials} materi · ${z.learners} learner`);rows($('#quizzes'),[...x.quizzes.map(z=>`${z.title} · ${z.attempts} percobaan · rata-rata ${z.average_score??'—'} · lulus ${z.passed}`),...x.difficultQuestions.map(z=>`Sulit · ${z.course_title} · ${z.prompt} · salah ${z.incorrect}/${z.answers}`)],z=>z)}
async function loadC34(){const [t,q,b,r]=await Promise.all([get('/api/admin/member-c/templates'),get('/api/admin/member-c/queue'),get('/api/admin/member-c/question-bank'),get('/api/admin/member-c/rubrics')]);rows($('#templates'),t.templates,x=>`${x.key} · ${x.title} · ${x.channels.join(', ')}`);rows($('#queue'),q.deliveries,x=>`${fmt(x.scheduled_at)} · ${x.email} · ${x.channel} · ${x.status}${x.last_error?' · '+x.last_error:''}`);rows($('#bank'),b.questions,x=>`${x.course_title} · ${x.prompt}`);rows($('#rubrics'),r.rubrics,x=>`${x.title} · ${x.criteria.length} kriteria`)}
async function load(){try{$('#notice').textContent='';$('#refresh').disabled=true;await Promise.all([loadOps(),loadAnalytics(),loadC34()])}catch(e){if(e.status===401)location.href='/admin';else if(e.status!==403){$('#notice').textContent=e.message;$('#notice').className='message error'}}finally{$('#refresh').disabled=false}}
async function send(path,body={}){const r=await fetch(API+path,{method:'POST',credentials:'include',headers:{'content-type':'application/json'},body:JSON.stringify(body)}),x=await r.json().catch(()=>({}));if(!r.ok)throw Error(x.message||'Permintaan gagal');return x}
$('#template-form').onsubmit=async e=>{e.preventDefault();const f=new FormData(e.currentTarget);await send('/api/admin/member-c/templates',{key:f.get('key'),title:f.get('title'),body:f.get('body'),channels:['in_app',...(f.get('email')?['email']:[])]});e.currentTarget.reset();loadC34()};$('#process-queue').onclick=async()=>{await send('/api/admin/member-c/queue/process');loadC34()};$('#gradebook-form').onsubmit=async e=>{e.preventDefault();const course=new FormData(e.currentTarget).get('course'),x=await get(`/api/admin/member-c/gradebook/${course}`);rows($('#gradebook'),x.students,z=>`${z.name} · quiz ${z.quiz_average??'—'} · karya ${z.artwork_average??'—'}`);$('#gradebook-csv').hidden=false;$('#gradebook-csv').href=`${API}/api/admin/member-c/gradebook/${course}?format=csv`};$$('[data-tab]').forEach(tab=>tab.onclick=()=>{$$('[data-tab]').forEach(x=>x.setAttribute('aria-selected',String(x===tab)));$$('[data-panel]').forEach(x=>x.classList.toggle('hidden',x.dataset.panel!==tab.dataset.tab))});$('#refresh').onclick=load;$('#days').onchange=loadAnalytics;document.querySelector('.admin-menu .nav')?.addEventListener('click',e=>{if(e.target.closest('a,button'))e.currentTarget.closest('details')?.removeAttribute('open')});load();
</script></body></html>
