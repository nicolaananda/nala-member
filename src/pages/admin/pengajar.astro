---
import '../../styles.css';
const api=import.meta.env.PUBLIC_API_URL||'https://api.artstudionala.com';
---
<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="robots" content="noindex,nofollow"><title>Pengajar · Nala</title></head><body class="admin-shell" data-api={api}><header class="site-header"><div class="wrap header-inner"><a class="brand" href="/admin/"><img src="/nala-logo.png" alt=""><span><strong>Nala Studio</strong><small>Tim pengajar</small></span></a><nav class="nav" aria-label="Navigasi pengajar"><a href="/admin/">← Admin utama</a></nav></div></header><main class="wrap member-layout"><div class="section-head"><div><span class="eyebrow">Tim akademik</span><h1>Kelola pengajar</h1><p class="muted">Atur akun dan kelas evaluasi.</p></div></div><p id="status" class="message" role="status" aria-live="polite"></p><div class="account-grid"><form id="teacher" class="card teacher-form hidden"><label class="field">Email<input name="email" type="email" required maxlength="254"></label><label class="field">Password baru (kosongkan jika tidak diubah)<input name="password" type="password" minlength="10" maxlength="200" autocomplete="new-password"></label><label><input name="enabled" type="checkbox" checked> Aktif</label><fieldset id="courses"><legend>Kelas yang ditugaskan</legend></fieldset><button class="primary">Simpan pengajar</button></form><section><h2>Daftar pengajar</h2><div id="teachers" class="teacher-list" aria-live="polite"></div></section></div></main><script>
const form=document.querySelector('#teacher'),status=document.querySelector('#status'),root=document.querySelector('#teachers');
async function request(path,init={}){const r=await fetch(document.body.dataset.api+'/api/admin'+path,{credentials:'include',headers:{'Content-Type':'application/json'},...init});const data=await r.json();if(!r.ok)throw Error(data.message||'Permintaan gagal');return data}
async function list(){const {teachers}=await request('/member/teachers');root.replaceChildren();for(const teacher of teachers){const b=document.createElement('button');b.textContent=teacher.email+(teacher.enabled?' · Aktif':' · Nonaktif');b.onclick=()=>{form.elements.email.value=teacher.email;form.elements.password.value='';form.elements.enabled.checked=teacher.enabled;form.querySelectorAll('[name=course]').forEach(x=>x.checked=teacher.courses.map(String).includes(x.value))};root.append(b)}}
form.addEventListener('submit',async e=>{e.preventDefault();const b=form.querySelector('button');b.disabled=true;try{await request('/member/teachers',{method:'PUT',body:JSON.stringify({email:form.elements.email.value,password:form.elements.password.value,enabled:form.elements.enabled.checked,courses:[...form.querySelectorAll('[name=course]:checked')].map(x=>x.value)})});form.elements.password.value='';await list();status.textContent='Tersimpan. Sesi lama pengajar dicabut.'}catch(e){status.textContent=e.message}finally{b.disabled=false}});
(async()=>{try{const {admin}=await request('/me');if(admin.role==='teacher')throw Error('Hanya owner');const {courses}=await request('/member/courses');for(const c of courses){const label=document.createElement('label'),input=document.createElement('input');input.type='checkbox';input.name='course';input.value=c.id;label.append(input,document.createTextNode(c.title));document.querySelector('#courses').append(label)}await list();form.classList.remove('hidden')}catch(e){status.textContent=e.message}})();
</script></body></html>
