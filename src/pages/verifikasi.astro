---
import '../styles.css';
const api=import.meta.env.PUBLIC_API_URL||'https://api.artstudionala.com';
---
<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Verifikasi akun · Artstudio Nala</title></head><body data-api={api}><header class="site-header"><div class="wrap header-inner"><a class="brand" href="/"><img src="/nala-logo.png" alt="Artstudio Nala"></a></div></header><main class="wrap auth-shell"><section class="card"><span class="eyebrow">Keamanan akun</span><h1>Verifikasi email</h1><p id="status" class="message" role="status" aria-live="polite">Memverifikasi tautan…</p><div class="form-actions"><a class="button" href="/portal?view=login">Masuk ke portal</a><button id="retry" class="secondary hidden">Coba lagi</button></div></section></main><script>const s=document.querySelector('#status'),b=document.querySelector('#retry');async function verify(){b.classList.add('hidden');s.className='message';s.textContent='Memverifikasi tautan…';try{const r=await fetch(document.body.dataset.api+'/api/member/verify',{method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({token:new URLSearchParams(location.search).get('token')||''})}),x=await r.json();s.textContent=x.message||'Verifikasi gagal.';s.className=`message ${r.ok?'success':'error'}`;if(!r.ok)b.classList.remove('hidden')}catch{s.textContent='Server tidak dapat dihubungi. Periksa koneksi lalu coba lagi.';s.className='message error';b.classList.remove('hidden')}}b.onclick=verify;verify()</script></body></html>