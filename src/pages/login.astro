---
import '../styles.css';
const api = import.meta.env.PUBLIC_API_URL || 'https://api.artstudionala.com';
---
<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Masuk · Nala LMS</title><meta name="description" content="Masuk ke ruang belajar dan pengelolaan Artstudio Nala."></head><body data-api={api}>
<main class="auth-stage" data-structure="auth-card"><aside class="auth-context"><a class="brand" href="/"><img src="/nala-logo.png" alt="Artstudio Nala"></a><span class="eyebrow">Nala Learning Management System</span><h1>Satu akun untuk belajar dan mengajar.</h1><p>Akses kelas, karya, evaluasi, dan pengelolaan studio dari ruang yang sesuai dengan peran Anda.</p></aside><section class="auth-panel"><p id="notice" class="message" role="status" aria-live="polite"></p><form id="login-form" class="card"><span class="eyebrow">Selamat datang kembali</span><h2>Masuk ke Nala LMS</h2><p class="muted">Gunakan email yang terdaftar pada akun Nala.</p><label class="field">Email<input name="email" type="email" autocomplete="username" required></label><label class="field">Kata sandi<input name="password" type="password" autocomplete="current-password" required></label><button class="primary">Masuk</button><div class="auth-links"><a href="/login?mode=register">Belum punya akun? Daftar</a><button id="forgot" type="button" class="link-button">Lupa kata sandi</button><button id="resend-link" type="button" class="link-button">Kirim ulang verifikasi</button></div></form><form id="register-form" class="card hidden"><span class="eyebrow">Akun baru</span><h2>Daftar sebagai peserta</h2><label class="field">Nama lengkap<input name="name" autocomplete="name" required></label><label class="field">Email<input name="email" type="email" autocomplete="email" required></label><label class="field">Kata sandi<input name="password" type="password" minlength="8" autocomplete="new-password" required></label><button class="primary">Buat akun</button><a href="/login">Kembali ke halaman masuk</a></form><form id="resend-form" class="card hidden"><span class="eyebrow">Verifikasi akun</span><h2>Kirim ulang email verifikasi</h2><label class="field">Email<input name="email" type="email" autocomplete="email" required></label><button class="primary">Kirim email</button><a href="/login">Kembali ke halaman masuk</a></form></section></main>
<script>
const API=document.body.dataset.api,$=s=>document.querySelector(s),notice=$('#notice');
const allowed=new Set(['/portal','/admin/','/admin/?view=evaluations']);
const requested=new URLSearchParams(location.search).get('next');
const say=(text,error=false)=>{notice.textContent=text;notice.className=`message ${error?'error':'success'}`};
async function call(path,init={}){const response=await fetch(API+path,{credentials:'include',headers:{'Content-Type':'application/json'},...init}),data=await response.json().catch(()=>({message:'Respons server tidak valid.'}));if(!response.ok)throw Object.assign(Error(data.message||'Permintaan gagal.'),{status:response.status});return data}
function destination(role){const fixed=role==='owner'?'/admin/':role==='teacher'?'/admin/?view=evaluations':'/portal';return requested&&allowed.has(requested)&&((role==='learner'&&requested==='/portal')||(role!=='learner'&&requested.startsWith('/admin/')))?requested:fixed}
function mode(name){['login','register','resend'].forEach(x=>$(`#${x}-form`).classList.toggle('hidden',x!==name))}
async function restore(){for(const [path,role] of [['/api/admin/me','admin'],['/api/member/me','learner']])try{const x=await call(path);location.replace(destination(role==='learner'?'learner':x.admin?.role||'owner'));return}catch{}mode(new URLSearchParams(location.search).get('mode')==='register'?'register':'login')}
$('#login-form').onsubmit=async event=>{event.preventDefault();const button=event.currentTarget.querySelector('button');button.disabled=true;try{const result=await call('/api/auth/login',{method:'POST',body:JSON.stringify(Object.fromEntries(new FormData(event.currentTarget)))});location.replace(destination(result.role||result.user?.role||'learner'))}catch(error){say(error.message,true);button.disabled=false}};
$('#register-form').onsubmit=async event=>{event.preventDefault();try{const form=new FormData(event.currentTarget),result=await call('/api/member/register',{method:'POST',body:JSON.stringify(Object.fromEntries(form))});say(result.message||'Akun dibuat. Periksa email untuk verifikasi.');$('#resend-form [name=email]').value=form.get('email');mode('resend')}catch(error){say(error.message,true)}};
$('#resend-form').onsubmit=async event=>{event.preventDefault();try{const result=await call('/api/member/resend-verification',{method:'POST',body:JSON.stringify(Object.fromEntries(new FormData(event.currentTarget)))});say(result.message||'Email verifikasi dikirim.')}catch(error){say(error.message,true)}};
$('#resend-link').onclick=()=>mode('resend');$('#forgot').onclick=async()=>{const email=$('#login-form [name=email]').value;if(!email)return say('Isi email terlebih dahulu.',true);try{const result=await call('/api/member/forgot-password',{method:'POST',body:JSON.stringify({email})});say(result.message||'Tautan reset telah dikirim.')}catch(error){say(error.message,true)}};restore();
</script></body></html>